---
// A wall of clips made in Emaki, each hung at its true shape: portrait menu
// boards next to landscape screens, a square post beside a story.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Clip from '../components/Clip.astro';
import { showcaseRows, byFile } from '../data/showcase';

const rows = showcaseRows.map((r) => r.map(byFile));
const count = rows.flat().length;
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven'];
---

<Base
  title="Showcase: Emaki"
  description="Short looping clips made in Emaki, the desktop motion design app: menu boards for café screens, a social post, a story, a logo reveal and a title card."
>
  <SiteHeader />
  <main id="main">
    <div class="wrap page-head split">
      <h1>Clips at their real shape</h1>
      <p>
        {words[count - 1]} of Emaki's built-in templates and a price tag pinned with its motion tracking, only made
        smaller for the web. Each template opens in the app with its timing in place, waiting for your own words.
      </p>
    </div>

    <section class="wall" aria-label="Clips">
      <div class="wall-inner">
        {
          rows.map((row) => (
            <div class="row">
              {row.map((c) => (
                <div class:list={['item', c.height > c.width ? 'tall' : c.height === c.width ? 'square' : 'wide']} style={`--ar: ${c.width / c.height}`}>
                  <Clip clip={c} caption={false} class="hung" />
                  <p class="plaque">
                    <b>{c.title}</b>
                    <span>{c.caption}</span>
                    <span class="meta">
                      {c.width} × {c.height} · {c.use}
                    </span>
                  </p>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <p class="wrap foot-note">
      These were saved as MP4 video. The app can also save WebM, ProRes 4444 with a transparent background, GIF,
      Lottie and PNG. <a href="/use-cases">What each kind of clip is for</a>
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  /* The wall: a band a shade darker than the page, with a picture rail along the top. */
  .wall {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    padding-block: 0 clamp(48px, 7vw, 96px);
  }
  .wall-inner {
    width: min(100% - 2.5rem, 1320px);
    margin-inline: auto;
    border-top: 3px solid var(--border-strong);
    padding-top: clamp(40px, 6vw, 72px);
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }
  .row {
    display: flex;
    gap: clamp(24px, 3vw, 48px);
    align-items: flex-start;
  }
  /* Grow in proportion to shape, so every clip in a row hangs at one height. */
  .item {
    flex: var(--ar) 1 0;
    min-width: 0;
  }
  .item :global(.hung .frame) {
    border-radius: 4px;
    border: 0;
    box-shadow:
      0 0 0 1px rgb(31 27 22 / 0.12),
      0 2px 4px rgb(31 27 22 / 0.08),
      0 18px 36px -18px rgb(31 27 22 / 0.4);
  }
  .plaque {
    display: grid;
    gap: 4px;
    margin: 16px 0 0;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-dim);
  }
  .plaque b {
    font-weight: 500;
    color: var(--text);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 700px) {
    .row {
      flex-direction: column;
      gap: 48px;
    }
    .item {
      flex: none;
      width: 100%;
    }
    .item.tall {
      width: 64%;
    }
    .item.square {
      width: 86%;
    }
  }

  .foot-note {
    padding-block: 32px clamp(48px, 8vw, 96px);
    margin-block: 0;
    color: var(--text-dim);
  }
</style>
