---
// The hero: the Emaki editor, drawn in code. Layers on the left, an artboard
// with a small café-screen scene in the middle, the selected layer's inspector
// on the right and the timeline below. One clock drives the scene, the
// playhead, the timecode and the inspector's numbers, so they stay in step.
//
// Without JavaScript, or when the visitor prefers reduced motion, the markup
// below is the composed still frame (everything in place, playhead at STILL).

const LENGTH = 5; // seconds per loop
const STILL = 3.4; // the composed frame

// Timeline rows: name, colour, segments [start, end, label] in seconds.
const rows = [
  { name: 'Tagline', colour: '#f3d6bf', segs: [[2.3, 3.0, 'Slide in']] },
  { name: 'Ribbon', colour: 'var(--mint)', segs: [[1.9, 2.7, 'Draw on']] },
  { name: 'Title', colour: '#c7d5ea', segs: [[0.9, 2.06, 'Rise by letter']] },
  { name: 'Ball', colour: 'var(--pink)', segs: [[0.4, 2.2, 'Follow path'], [2.2, 2.7, 'Sparkle']], selected: true },
  { name: 'Square', colour: 'var(--butter)', segs: [[0, 0.8, 'Pop in']] },
] as const;

// The layers panel, top to bottom as in the app.
const layers = [
  { name: 'Tagline', icon: 'text' },
  { name: 'Ribbon', icon: 'path' },
  { name: 'Title', icon: 'text' },
  { name: 'Ball', icon: 'ellipse', selected: true },
  { name: 'Sparkle', icon: 'path', child: true },
  { name: 'Square', icon: 'rect' },
  { name: 'Background', icon: 'rect' },
] as const;

const icons: Record<string, string> = {
  text: '<path d="M4 4.5h8M8 4.5v8"/>',
  path: '<path d="M3 12c2-7 5-1 10-8"/><circle cx="3" cy="12" r="1.2"/><circle cx="13" cy="4" r="1.2"/>',
  ellipse: '<circle cx="8" cy="8" r="5"/>',
  rect: '<rect x="3" y="3" width="10" height="10" rx="2"/>',
};

const pct = (s: number) => `${((s / LENGTH) * 100).toFixed(3)}%`;
const ticks = Array.from({ length: LENGTH * 2 + 1 }, (_, i) => i / 2);
const title = 'Good morning';
const timecode = (s: number) => `0:${String(Math.floor(s)).padStart(2, '0')}.${String(Math.floor((s % 1) * 30)).padStart(2, '0')}`;
// The ball's resting place, in artboard pixels (the scene is drawn at a third of 1920 × 1080).
const BALL = { x: 556 * 3, y: 74 * 3 };
---

<figure class="editor" data-hero data-length={LENGTH} data-still={STILL}>
  <div class="win">
    <div class="bar" aria-hidden="true">
      <span class="file"><b>Café screen</b> <span>Saved</span></span>
      <span class="bar-tools">
        <span class="zoom">50%</span>
        <span class="chip">Preview</span>
        <span class="chip primary">Export</span>
      </span>
    </div>

    <div class="body">
      <div class="panel layers" aria-hidden="true">
        <p class="panel-title">Layers</p>
        <ul>
          {
            layers.map((l) => (
              <li class:list={[{ selected: 'selected' in l && l.selected, child: 'child' in l && l.child }]}>
                <svg viewBox="0 0 16 16" width="14" height="14" set:html={icons[l.icon]} />
                {l.name}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="canvas">
        <p class="board-name" aria-hidden="true"><b>Café screen</b> 1920 × 1080 · 30 fps</p>
        <div class="stage" aria-hidden="true">
          <svg class="scene" viewBox="0 0 640 360" preserveAspectRatio="xMidYMid meet">
            <rect width="640" height="360" fill="#1d2b45" />
            <g data-fade>
              <path
                d="M 64 128 C 150 40, 250 40, 320 100 S 470 150, 556 74"
                fill="none"
                stroke="#fbf3e4"
                stroke-width="1.5"
                stroke-dasharray="2 6"
                stroke-linecap="round"
                data-guide
              />
              <path
                d="M 64 128 C 150 40, 250 40, 320 100 S 470 150, 556 74"
                fill="none"
                stroke="#ffb3c7"
                stroke-width="3"
                stroke-linecap="round"
                pathLength="1"
                stroke-dasharray="1 1"
                data-trail
              />
              <path
                d="M 50 238 C 110 222, 150 254, 210 238 S 310 222, 370 238 S 410 248, 428 240"
                fill="none"
                stroke="#a8e6cf"
                stroke-width="7"
                stroke-linecap="round"
                pathLength="1"
                stroke-dasharray="1 1"
                data-ribbon
              />
              <g transform="translate(540 262)"><circle cx="40" cy="-44" r="14" fill="#fbf3e4" data-dot /></g>
              <g transform="translate(540 262)">
                <rect x="-34" y="-34" width="68" height="68" rx="16" fill="#ffe3a8" data-square />
              </g>
              <g transform="translate(556 74)">
                <path
                  d="M 0 -22 C 3 -6, 6 -3, 22 0 C 6 3, 3 6, 0 22 C -3 6, -6 3, -22 0 C -6 -3, -3 -6, 0 -22 Z"
                  fill="#fbf3e4"
                  data-sparkle
                />
              </g>
              <g data-ball>
                <circle cx="556" cy="74" r="15" fill="#ffb3c7" />
                <g class="selection">
                  <rect x="537" y="55" width="38" height="38" fill="none" stroke="#9fbbe6" stroke-width="1" />
                  <rect x="534.5" y="52.5" width="5" height="5" />
                  <rect x="572.5" y="52.5" width="5" height="5" />
                  <rect x="534.5" y="90.5" width="5" height="5" />
                  <rect x="572.5" y="90.5" width="5" height="5" />
                </g>
              </g>
            </g>
          </svg>
          <div class="type" data-fade>
            <p class="title">
              {[...title].map((ch) => <span data-letter>{ch === ' ' ? '\u00a0' : ch}</span>)}
            </p>
            <p class="tagline" data-tagline>Fresh coffee from 7am</p>
          </div>
        </div>
      </div>

      <div class="panel inspector" aria-hidden="true">
        <p class="panel-title">Ball <span>Ellipse</span></p>
        <div class="tabs"><span>Design</span><span class="on">Animate</span></div>
        <p class="group">Position</p>
        <div class="fields">
          <span class="field"><i>X</i><b data-x>{BALL.x}</b></span>
          <span class="field"><i>Y</i><b data-y>{BALL.y}</b></span>
        </div>
        <p class="group">Animations</p>
        <div class="anim on">
          <span class="anim-name">Follow path</span>
          <span class="anim-meta">0:00.12 – 0:02.06</span>
          <svg class="curve" viewBox="0 0 120 40" preserveAspectRatio="none">
            <path d="M 2 38 C 50 38, 70 2, 118 2" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="anim-meta">Ease in and out</span>
        </div>
        <div class="anim">
          <span class="anim-name">Sparkle</span>
          <span class="anim-meta">0:02.06 – 0:02.21</span>
        </div>
      </div>
    </div>

    <div class="timeline" style={`--still: ${STILL / LENGTH}`}>
      <div class="transport">
        <button class="play" type="button" data-play aria-label="Play animation" aria-pressed="false">
          <svg class="i-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
        </button>
        <span class="time" data-time aria-hidden="true">{timecode(STILL)}</span>
        <span class="length" aria-hidden="true">/ {timecode(LENGTH)}</span>
      </div>
      <div class="ruler" aria-hidden="true">
        {
          ticks.map((t) => (
            <span class:list={['tick', { major: t % 1 === 0 }]} style={`left: ${pct(t)}`}>
              {t % 1 === 0 && t < LENGTH && <b>{t}s</b>}
            </span>
          ))
        }
      </div>
      <ul class="rows" aria-hidden="true">
        {
          rows.map((r) => (
            <li class:list={[{ selected: 'selected' in r && r.selected }]} style={`--c: ${r.colour}`}>
              <span class="label">{r.name}</span>
              <span class="track">
                {r.segs.map(([a, b, label]) => (
                  <span class="seg" data-a={a} data-b={b} style={`left: ${pct(a)}; width: ${pct(b - a)}`}>
                    <span>{label}</span>
                  </span>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="playhead-lane" aria-hidden="true">
        <div class="playhead" data-playhead></div>
      </div>
    </div>
  </div>
  <figcaption class="visually-hidden">
    A sketch of the Emaki editor at work on a café screen: on the artboard a square pops in, a ball follows a curved
    path, the words Good morning rise letter by letter and a ribbon draws on, while the playhead moves along the
    timeline below and the inspector shows the ball's position.
  </figcaption>
</figure>

<script>
  const ease = {
    outCubic: (p: number) => 1 - (1 - p) ** 3,
    inOutCubic: (p: number) => (p < 0.5 ? 4 * p ** 3 : 1 - (-2 * p + 2) ** 3 / 2),
    outBack: (p: number) => 1 + 2.4 * (p - 1) ** 3 + 1.4 * (p - 1) ** 2,
  };
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const span = (t: number, a: number, b: number) => clamp((t - a) / (b - a));

  for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    const LENGTH = Number(root.dataset.length);
    const STILL = Number(root.dataset.still);
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const guide = q<SVGPathElement>('[data-guide]');
    const trail = q<SVGPathElement>('[data-trail]');
    const ribbon = q<SVGPathElement>('[data-ribbon]');
    const ball = q<SVGGElement>('[data-ball]');
    const square = q<SVGRectElement>('[data-square]');
    const dot = q<SVGCircleElement>('[data-dot]');
    const sparkle = q<SVGPathElement>('[data-sparkle]');
    const tagline = q<HTMLElement>('[data-tagline]');
    const letters = [...root.querySelectorAll<HTMLElement>('[data-letter]')];
    const fades = [...root.querySelectorAll<HTMLElement | SVGGElement>('[data-fade]')];
    const segs = [...root.querySelectorAll<HTMLElement>('.seg')];
    const anims = [...root.querySelectorAll<HTMLElement>('.anim')];
    const playhead = q<HTMLElement>('[data-playhead]');
    const time = q<HTMLElement>('[data-time]');
    const fx = q<HTMLElement>('[data-x]');
    const fy = q<HTMLElement>('[data-y]');
    const button = q<HTMLButtonElement>('[data-play]');
    const total = guide.getTotalLength();

    const render = (t: number) => {
      // Square: pops in with a turn.
      const ps = span(t, 0, 0.8);
      square.style.transform = `rotate(${(1 - ease.outCubic(ps)) * -120}deg) scale(${ease.outBack(ps)})`;
      square.style.opacity = String(clamp(ps * 4));
      const pd = span(t, 0.25, 0.9);
      dot.style.transform = `scale(${ease.outBack(pd)})`;
      // Ball: follows the curved path, leaving a trail; the selection and the inspector go with it.
      const pb = ease.inOutCubic(span(t, 0.4, 2.2));
      const pt = guide.getPointAtLength(pb * total);
      ball.style.transform = `translate(${pt.x - 556}px, ${pt.y - 74}px)`;
      ball.style.opacity = String(clamp(span(t, 0.2, 0.45)));
      fx.textContent = String(Math.round(pt.x * 3));
      fy.textContent = String(Math.round(pt.y * 3));
      guide.style.opacity = String(0.5 * span(t, 0.1, 0.4));
      trail.style.strokeDashoffset = String(1 - pb);
      // Sparkle: pops where the ball lands.
      const pk = span(t, 2.2, 2.7);
      sparkle.style.transform = `rotate(${(1 - ease.outCubic(pk)) * 90}deg) scale(${ease.outBack(pk)})`;
      // Title: rises letter by letter.
      letters.forEach((el, i) => {
        const pl = span(t, 0.9 + i * 0.06, 1.4 + i * 0.06);
        el.style.transform = `translateY(${(1 - ease.outBack(pl)) * 0.55}em)`;
        el.style.opacity = String(clamp(pl * 2.5));
      });
      // Ribbon: draws on under the title.
      ribbon.style.strokeDashoffset = String(1 - ease.inOutCubic(span(t, 1.9, 2.7)));
      // Tagline: slides in.
      const pg = ease.outCubic(span(t, 2.3, 3.0));
      tagline.style.transform = `translateX(${(1 - pg) * -1.2}em)`;
      tagline.style.opacity = String(pg);
      // Everything fades before the loop starts again.
      const out = String(1 - span(t, 4.4, 4.8));
      for (const f of fades) f.style.opacity = out;
      // Timeline and inspector.
      playhead.style.transform = `translateX(${(t / LENGTH) * 100}%)`;
      for (const s of segs) s.classList.toggle('on', t >= Number(s.dataset.a) && t < Number(s.dataset.b));
      anims[0].classList.toggle('on', t < 2.2);
      anims[1].classList.toggle('on', t >= 2.2 && t < 2.7);
      const frames = Math.floor((t % 1) * 30);
      time.textContent = `0:${String(Math.floor(t)).padStart(2, '0')}.${String(frames).padStart(2, '0')}`;
    };

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let playing = !reduce.matches;
    let visible = true;
    let t = playing ? 0 : STILL;
    let last = 0;
    let raf = 0;

    const frame = (now: number) => {
      raf = 0;
      if (last) t = (t + (now - last) / 1000) % LENGTH;
      last = now;
      render(t);
      schedule();
    };
    const schedule = () => {
      if (playing && visible && !document.hidden && !raf) raf = requestAnimationFrame(frame);
      if (!(playing && visible && !document.hidden)) last = 0;
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      root.classList.toggle('is-playing', on);
      button.setAttribute('aria-pressed', String(on));
      button.setAttribute('aria-label', on ? 'Pause animation' : 'Play animation');
      if (!on && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      last = 0;
      schedule();
    };

    render(t);
    button.addEventListener('click', () => setPlaying(!playing));
    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        setPlaying(false);
        t = STILL;
        render(t);
      }
    });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      schedule();
    }).observe(root);
    setPlaying(playing);
  }
</script>

<style>
  .editor {
    margin: 0;
  }
  /* The window: the app's own light chrome, in the page's palette. */
  .win {
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(31 27 22 / 0.06),
      0 24px 64px -24px rgb(31 27 22 / 0.28);
    font-size: 12px;
    line-height: 16px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
  }
  .file b {
    font-weight: 500;
    color: var(--text);
    margin-right: 8px;
  }
  .bar-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .zoom {
    font-variant-numeric: tabular-nums;
    padding-right: 4px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-weight: 500;
  }
  .chip.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .body {
    display: grid;
    grid-template-columns: 184px minmax(0, 1fr) 216px;
  }
  .panel {
    padding: 12px;
    color: var(--text-dim);
  }
  .layers {
    border-right: 1px solid var(--border);
  }
  .inspector {
    border-left: 1px solid var(--border);
  }
  .panel-title {
    margin: 0 0 8px;
    padding: 0 4px;
    font-weight: 500;
    color: var(--text);
  }
  .panel-title span {
    font-weight: 400;
    color: var(--text-muted);
    margin-left: 4px;
  }
  .layers ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .layers li {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
  }
  .layers li.child {
    padding-left: 28px;
  }
  .layers li.selected {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }
  .layers svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    color: var(--text-muted);
  }
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 2px;
    margin-bottom: 16px;
    border-radius: 8px;
    background: var(--raised);
    text-align: center;
  }
  .tabs span {
    height: 24px;
    line-height: 24px;
    border-radius: 6px;
  }
  .tabs .on {
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
  }
  .group {
    margin: 0 0 8px;
    padding: 0 4px;
    color: var(--text-muted);
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--raised);
  }
  .field i {
    font-style: normal;
    color: var(--text-muted);
  }
  .field b {
    font-weight: 500;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .anim {
    display: grid;
    gap: 4px;
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 150ms var(--ease);
  }
  .anim.on {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .anim-name {
    color: var(--text);
    font-weight: 500;
  }
  .anim-meta {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .anim .curve {
    width: 100%;
    height: 40px;
    margin: 4px 0;
    color: var(--accent);
  }

  /* The editor canvas with its artboard. */
  .canvas {
    background: var(--bg-alt);
    padding: 24px clamp(12px, 4vw, 48px) 32px;
    min-width: 0;
  }
  .board-name {
    margin: 0 0 8px;
    color: var(--text-muted);
  }
  .board-name b {
    font-weight: 500;
    color: var(--text);
    margin-right: 4px;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    container-type: inline-size;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(31 27 22 / 0.12), 0 12px 28px -14px rgb(31 27 22 / 0.4);
  }
  .scene {
    display: block;
    width: 100%;
    height: 100%;
  }
  .scene [data-square],
  .scene [data-sparkle],
  .scene [data-dot] {
    transform-box: fill-box;
    transform-origin: center;
  }
  .scene [data-trail],
  .scene [data-ribbon] {
    stroke-dashoffset: 0;
  }
  .scene [data-guide] {
    opacity: 0.5;
  }
  .selection rect + rect {
    fill: #fbf3e4;
    stroke: #9fbbe6;
    stroke-width: 1;
  }
  .type {
    position: absolute;
    inset: 0;
    color: #fbf3e4;
  }
  .title {
    position: absolute;
    left: 7.5%;
    top: 40%;
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 9.4cqw;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .title span {
    display: inline-block;
  }
  .tagline {
    position: absolute;
    left: 7.8%;
    top: 74%;
    margin: 0;
    font-size: 3.2cqw;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgb(251 243 228 / 0.75);
    white-space: nowrap;
  }

  /* Timeline strip. */
  .timeline {
    --label: 184px;
    --row: 28px;
    position: relative;
    display: grid;
    grid-template-columns: var(--label) 1fr;
    border-top: 1px solid var(--border);
  }
  .transport {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    height: 36px;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .play {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border: 0;
    border-radius: 6px;
    background: var(--raised);
    color: var(--text);
    cursor: pointer;
    transition: background-color 150ms var(--ease);
  }
  .play:hover {
    background: var(--border-strong);
  }
  .play .i-pause,
  .is-playing .play .i-play {
    display: none;
  }
  .is-playing .play .i-pause {
    display: block;
  }
  .time {
    font-weight: 500;
    color: var(--text);
  }
  .length {
    color: var(--text-muted);
  }
  .ruler {
    position: relative;
    height: 36px;
    margin-right: 16px;
    margin-left: 8px;
    border-bottom: 1px solid var(--border);
  }
  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }
  .tick::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    border-left: 1px solid var(--border-strong);
  }
  .tick.major::after {
    height: 8px;
    border-left-color: var(--text-muted);
  }
  .tick b {
    position: absolute;
    top: 8px;
    left: 4px;
    font-weight: 400;
