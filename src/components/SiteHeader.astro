---
// The top bar on every page.
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/#inside', label: 'Features', hide: 'narrow' },
  { href: '/showcase', label: 'Showcase' },
  { href: '/use-cases', label: 'Use cases', hide: 'narrow' },
  { href: '/roadmap', label: 'Roadmap', hide: 'narrow' },
  { href: '/changelog', label: 'Changelog', hide: 'narrow' },
  { href: '/get-started', label: 'Get started' },
];
---

<header class="top">
  <div class="wrap top-row">
    <a href="/" class="brand" aria-label="Emaki home">
      <Logo id="logo-top" animate={path === '/'} height={36} />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li class:list={[l.hide]}>
              <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .top {
    padding-block: 20px;
  }
  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    flex: none;
    border-radius: 6px;
  }
  ul {
    display: flex;
    gap: clamp(12px, 2.4vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a:not(.brand) {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 8px 0;
    transition: color 150ms var(--ease);
  }
  a:not(.brand):hover {
    color: var(--accent);
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  @media (max-width: 860px) {
    .narrow {
      display: none;
    }
  }
</style>
