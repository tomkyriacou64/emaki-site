---
import Page from '../layouts/Page.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { APPIMAGE_URL } from '../config';

// From the app's own shortcut sheet (hold ? in Emaki to see them all).
const shortcuts = [
  { keys: ['Space'], does: 'Play or pause' },
  { keys: [',', '.'], does: 'Step back or forward one frame (with Shift: 10 frames)' },
  { keys: ['V'], does: 'Select tool' },
  { keys: ['R', 'O', 'T', 'P'], does: 'Rectangle, ellipse, text and pen tools' },
  { keys: ['F'], does: 'Artboard tool' },
  { keys: ['A'], does: 'Add an animation to the selected layer' },
  { keys: ['G'], does: 'Open the graph editor' },
  { keys: ['Ctrl+D'], does: 'Duplicate' },
  { keys: ['Ctrl+G'], does: 'Group' },
  { keys: ['Ctrl+Alt+M'], does: 'Make a mask from the selection' },
  { keys: ['Shift+1'], does: 'Zoom to fit all artboards' },
  { keys: ['Ctrl+K'], does: 'Command palette' },
  { keys: ['Ctrl+Enter'], does: 'Full-screen preview' },
  { keys: ['Ctrl+S'], does: 'Save' },
  { keys: ['Ctrl+E'], does: 'Export' },
  { keys: ['?'], does: 'Hold to see every shortcut' },
];
---

<Page
  title="Get started"
  description="Download Emaki for Linux, check what it needs, make a first animation in five steps and learn the most useful keyboard shortcuts."
  heading="From download to first export"
>
  <p slot="intro">Emaki runs on Linux today. Here's how to get it running and make your first animation.</p>

  <div class="steps-grid">
    <section class="block" aria-labelledby="download">
      <h2 id="download"><span class="num">1</span> Download and run</h2>
      {
        APPIMAGE_URL ? (
          <p>Download the AppImage, make it executable, and run it. There's nothing to install.</p>
        ) : (
          <div class="note-box">
            <p>
              The download isn't public yet. It will be here when Emaki is out. Until then, the steps below show what
              to expect.
            </p>
          </div>
        )
      }
      <Cta />
      <pre><code>chmod +x Emaki-*-x86_64.AppImage
./Emaki-*-x86_64.AppImage</code></pre>
      <p class="small">
        Or double-click it in your file manager once it's executable. It opens on Home, where you can try the demo
        project or a template.
      </p>
    </section>

    <section class="block" aria-labelledby="needs">
      <h2 id="needs"><span class="num">2</span> What it needs</h2>
      <ul class="checks">
        <li>
          <Icon name="check" size={18} />
          <span>A 64-bit Linux with glibc 2.30 or newer (Ubuntu 20.04 and later, or similar).</span>
        </li>
        <li>
          <Icon name="check" size={18} />
          <span>A graphics card and driver with Vulkan. Emaki draws and exports on the GPU.</span>
        </li>
        <li>
          <Icon name="check" size={18} />
          <span>Wayland or X11. File dialogs use your desktop's portal (<code>xdg-desktop-portal</code>).</span>
        </li>
        <li>
          <Icon name="check" size={18} />
          <span>ALSA for sound, which desktop distributions already have.</span>
        </li>
        <li>
          <Icon name="check" size={18} />
          <span>Nothing else: FFmpeg is inside the AppImage, so every export format works.</span>
        </li>
      </ul>
    </section>
  </div>

  <section class="block wide" aria-labelledby="first">
    <h2 id="first"><span class="num">3</span> Your first animation</h2>
    <ol class="first">
      <li>
        <strong>Start a project.</strong> On Home, click <em>New project</em>, or pick a template to start from
        something that already moves.
      </li>
      <li>
        <strong>Draw something.</strong> Press <kbd>R</kbd> for a rectangle or <kbd>T</kbd> for text, then drag on the
        artboard.
      </li>
      <li>
        <strong>Animate it.</strong> With the layer selected, press <kbd>A</kbd> and pick an animation from the
        gallery. It lands on the timeline.
      </li>
      <li>
        <strong>Retime it.</strong> Drag the bar on the timeline to move it, or its edges to change its length. Press
        <kbd>Space</kbd> to play.
      </li>
      <li>
        <strong>Export.</strong> Press <kbd>Ctrl</kbd>+<kbd>E</kbd>, choose MP4, GIF or another format, and export.
        <kbd>Ctrl</kbd>+<kbd>S</kbd> saves the project as a <code>.emaki</code> folder.
      </li>
    </ol>
  </section>

  <section class="block wide" aria-labelledby="keys">
    <h2 id="keys"><span class="num">4</span> Useful shortcuts</h2>
    <p>The defaults; you can change any of them in <em>Menu › Keyboard shortcuts</em>.</p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th scope="col">Keys</th><th scope="col">What it does</th></tr>
        </thead>
        <tbody>
          {
            shortcuts.map((s) => (
              <tr>
                <td class="keys">
                  {s.keys.map((k, i) => (
                    <>
                      {i > 0 && ' '}
                      <kbd>{k}</kbd>
                    </>
                  ))}
                </td>
                <td>{s.does}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Page>

<style>
  .steps-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .block {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    min-width: 0;
  }
  .block.wide {
    margin-top: 1.5rem;
  }
  .block h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.4rem;
  }
  .num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1rem;
  }
  .block p,
  .block li {
    color: var(--text-dim);
  }
  .block :global(.cta) {
    margin-bottom: 1rem;
  }
  pre {
    margin: 0 0 1rem;
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    font-size: 0.9rem;
  }
  pre code {
    padding: 0;
    background: none;
  }
  .small {
    font-size: 0.92rem;
    margin: 0;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .checks li {
    display: flex;
    gap: 0.6rem;
  }
  .checks :global(svg) {
    color: var(--accent);
    flex: none;
    margin-top: 0.3rem;
  }
  .first {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.6rem;
  }
  .first strong {
    color: var(--text);
  }
  .keys {
    white-space: nowrap;
    width: 12rem;
  }
  .table-wrap {
    background: var(--bg);
  }
</style>
