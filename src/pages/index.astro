---
// The landing page, read like a scroll: each section is a scene, marked on a
// small timeline ruler (`.mark`) with its timecode.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Shot from '../components/Shot.astro';
import Crop from '../components/Crop.astro';
import HeroEditor from '../components/HeroEditor.astro';
import Emakimono from '../components/Emakimono.astro';
import Cta from '../components/Cta.astro';
import Clip from '../components/Clip.astro';
import { byFile } from '../data/showcase';
import { GITHUB_URL, RELEASES_URL, FIGMA_PLUGIN_URL } from '../config';

import editor from '../assets/shots/mockups.png';
import graph from '../assets/shots/graph-editor.png';
import textPath from '../assets/shots/text-path.png';
import colour from '../assets/shots/colour.png';

// The clips on the home page; the showcase has them all.
const clips = ['morning-coffee', 'noodle-bar', 'social-post', 'mask-reveal'].map(byFile);
const tracked = byFile('price-tag-tracking');

// The four parts of the editor window, pinned on the screenshot (x, y as % of it).
const parts = [
  { x: 12, y: 46, title: 'Layers', text: 'Shapes, text, images, video and sound, in groups and masks' },
  { x: 42, y: 13, title: 'Canvas', text: 'Artboards side by side, with live phone, laptop and TV mockups beside them' },
  { x: 88, y: 60, title: 'Inspector', text: 'Size, timing and styles, with a Design tab and an Animate tab' },
  { x: 30, y: 88, title: 'Timeline', text: 'Drag a bar to retime it, or its edges to change its length' },
];

// Export formats, grouped by what they're for.
const formats = [
  { use: 'Screens and social', names: 'MP4 · WebM', text: 'Plays almost anywhere: signage players, phones, posts' },
  { use: 'Editing', names: 'ProRes 4444', text: 'Keeps the transparency, to lay over other footage' },
  { use: 'Web and apps', names: 'Lottie · GIF', text: 'Lottie stays sharp inside apps and sites; GIF for chats and docs' },
  { use: 'Stills', names: 'PNG', text: 'One frame, or every frame as a sequence' },
];

const also = [
  { title: 'Masks', text: 'Clip layers to a shape and animate the shape to reveal them' },
  { title: 'Components', text: 'Make a layer a component and place live copies, each with its own timing' },
  { title: 'Brand kits', text: 'Colours, text styles, logos and fonts in every project' },
  { title: 'Version history', text: 'Save named versions of a project and go back to any of them' },
  { title: 'Audio and video', text: 'Trim clips on the timeline and hear the sound as you preview' },
  { title: 'Effects', text: 'Blur, frosted glass, soft shadows, blend modes and colour keying' },
  { title: 'Templates', text: 'Social posts, logo reveals, lower thirds, kinetic type, stories and menu boards' },
  { title: 'Figma plugin', text: 'Copy frames in Figma and paste them in as editable layers' },
];
---

<Base
  title="Emaki: design a scene, then give it a timeline"
  description="Emaki is a free desktop app for motion graphics. Design on artboards, animate on a timeline with sound, and export MP4, WebM, ProRes, GIF, Lottie or PNG. Runs offline, with no account. Open source soon."
>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <h1 id="hero-title">Design a scene, then give it a timeline</h1>
        <div class="hero-side">
          <p class="lede">
            Emaki is a free desktop app for motion graphics. Lay out artboards, animate them with sound, and export MP4,
            GIF or Lottie. It runs on your own computer, offline, with no account.
          </p>
          <Cta tour />
        </div>
      </div>
      <div class="hero-view">
        <HeroEditor />
      </div>
    </section>

    <section class="scene editor" aria-labelledby="editor-title">
      <div class="wrap">
        <div class="head split">
          <div>
            <p class="mark"><time>0:05</time> The editor</p>
            <h2 id="editor-title">Layers, canvas, inspector and timeline in one window</h2>
          </div>
          <p>
            Everything sits where you can see it, and nothing opens in a separate app. Press <kbd>Space</kbd> and the
            artboard plays, with sound.
          </p>
        </div>
        <div class="pinned">
          <Shot
            src={editor}
            sizes="(min-width: 1200px) 1160px, 100vw"
            alt="The Emaki editor in the light theme: layers on the left, a vertical sale story artboard beside the same design on a phone mockup in the middle, the artboard's size and timing on the right, and the timeline with animation bars below."
          />
          {
            parts.map((p, i) => (
              <span class="pin" style={`left: ${p.x}%; top: ${p.y}%`} aria-hidden="true">
                {i + 1}
              </span>
            ))
          }
        </div>
        <div class="pinned-phone">
          <Crop
            src={editor}
            x={0.585}
            y={0.36}
            zoom={4.3}
            ratio={0.8}
            alt="The middle of the Emaki editor at full size: a vertical sale story artboard shown on a phone mockup."
          />
        </div>
        <ol class="legend">
          {
            parts.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="scene made" aria-labelledby="made-title">
      <div class="wrap">
        <div class="head split">
          <div>
            <p class="mark"><time>0:12</time> Made in Emaki</p>
            <h2 id="made-title">Every clip here is a built-in template</h2>
          </div>
          <p>
            Exported as they come, with nothing touched up afterwards. Open the same template, put in your own words
            and colours, and the timing is already done. <a href="/showcase">See them all</a>
          </p>
        </div>
      </div>
      <div class="strip" role="region" aria-label="Clips made in Emaki" tabindex="0">
        <ul>
          {
            clips.map((c) => (
              <li style={`--ar: ${c.width / c.height}`}>
                <Clip clip={c} caption={false} />
                <p class="clip-meta">
                  <span>{c.title}</span> {c.width} × {c.height}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="scene inside" id="inside" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="head">
          <p class="mark"><time>0:20</time> What's inside</p>
          <h2 id="inside-title">Draw it, time it, track it, export it</h2>
        </div>

        <ol class="rows">
          <li class="row">
            <div class="row-copy">
              <p class="kind">Design</p>
              <h3>Artboards on an endless canvas</h3>
              <p>
                Each artboard has its own size, background, frame rate and length, and you can add as many as you need.
              </p>
            </div>
            <ul class="list" aria-label="Design tools">
              <li>Shapes, a pen for paths, and rich text you edit right on the canvas</li>
              <li>Images, SVG as editable paths, video and audio</li>
              <li>Smart guides, auto layout and measuring as you drag</li>
            </ul>
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind">Animate</p>
              <h3>A gallery of presets, with keyframes underneath</h3>
              <p>
                Pick an animation from the gallery and it lands on the timeline as a bar you can drag. Open it into keyframes,
                shape any easing in the graph editor, bend a move into a curve, or make a layer follow a path.
              </p>
            </div>
            <Crop
              src={graph}
              x={0.7}
              y={0.84}
              zoom={1.8}
              ratio={2.6}
              alt="The timeline with the graph editor open, showing the position curves between a card's keyframes."
            />
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind">Type</p>
              <h3>Text by the letter, word or line</h3>
              <p>
                Set text along a path that stays editable, and animate how bold or wide a font is, for fonts that can
                change. Use the fonts on your computer, plus Google Fonts when you ask for them.
              </p>
            </div>
            <Crop
              src={textPath}
              x={0.42}
              y={0.4}
              zoom={1.7}
              alt="Text set around a circle on a path, with a variable font at weight 537 in the middle."
            />
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind">Track</p>
              <h3>Pin a layer to something in a video</h3>
              <p>
                Motion tracking follows a point from frame to frame. Pin a layer to one point and it moves with it, or to
                two and it also scales and turns. Track a screen's four corners and your design sits on it. Right-click
                a layer above a video to start; if the tracker is unsure about a frame, it marks it for you to fix.
              </p>
            </div>
            <figure class="tracked">
              <Clip clip={tracked} caption={false} />
              <figcaption>
                Made with Emaki's tracking: the price tag is pinned to two points, the cup's handle and the spoon, so it
                moves, grows and turns with them. The footage is a drawn café table under a simulated handheld camera.
              </figcaption>
            </figure>
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind">Colour</p>
              <h3>Grade with looks and curves</h3>
              <p>
                Start from a look such as Warm, Faded or Teal and orange, each previewed on your own layer. Adjust
                exposure, contrast, highlights, temperature and curves, and compare before and after in a split view.
              </p>
            </div>
            <Crop
              src={colour}
              x={0.66}
              y={0.5}
              zoom={1.45}
              alt="Four copies of a sunset photo graded differently, with the Looks menu open showing thumbnails such as Warm, Cool, Black and white and Faded."
            />
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind">Export</p>
              <h3>Six formats, each for a job</h3>
              <p>
                Export one artboard or all of them at once, at the size the place you post to expects. Sound comes along
                in the video formats.
              </p>
            </div>
            <dl class="formats">
              {
                formats.map((f) => (
                  <div>
                    <dt>{f.use}</dt>
                    <dd>
                      <b>{f.names}</b>
                      <span>{f.text}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </li>
        </ol>

        <div class="also">
          <h3>Also in the app</h3>
          <dl>
            {
              also.map((a) => (
                <div>
                  <dt>{a.title}</dt>
                  <dd>{a.text}</dd>
                </div>
              ))
            }
          </dl>
          <p class="small">
            The Figma plugin copies through your clipboard, so nothing leaves your computer.
            {
              FIGMA_PLUGIN_URL ? (
                <>
                  For now you install it from <a href={FIGMA_PLUGIN_URL}>the repository</a> as a development plugin.
                </>
              ) : (
                <> It comes with the source code, to install as a development plugin.</>
              )
            }
          </p>
        </div>
      </div>
    </section>

    <section class="scene meaning" id="name" aria-labelledby="name-title">
      <Emakimono>
        <div slot="head" class="wrap meaning-head">
          <p class="mark"><time>0:34</time> The name</p>
          <h2 id="name-title">Emaki means picture scroll</h2>
        </div>
        <p slot="hint" class="wrap hint">Read it from right to left. Scroll on, or drag the paper, to unroll it.</p>
      </Emakimono>
    </section>

    <section class="scene story" id="story" aria-labelledby="story-title">
      <div class="wrap story-grid">
        <div>
          <p class="mark"><time>0:41</time> The story</p>
          <h2 id="story-title">Started on honeymoon in Japan</h2>
        </div>
        <div class="story-copy">
          <p>
            I run a digital signage company. For years I made our content by designing in Figma, then animating it in
            Jitter. Jitter is good, but it was missing things I needed. I'm also a fan of open source, and none of the
            open-source tools ticked every box. So I built my own, starting it while on honeymoon in Japan.
          </p>
          <p class="pull">
            Emaki is essentially Figma with animation, plus motion tracking. It's completely free, and its code will be
            open source soon.
          </p>
          <p class="contribute">
            Once the code is public, contributors are very welcome to help make it great.
            {
              GITHUB_URL ? (
                <a href={GITHUB_URL}>Contribute on GitHub</a>
              ) : (
                <a href="/contributing">How contributing will work</a>
              )
            }
          </p>
        </div>
      </div>
    </section>

    <section class="scene get" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <p class="mark"><time>0:48</time> Get Emaki</p>
        <h2 id="get-title">Free, private and yours to keep</h2>
        <ul class="terms">
          <li><b>Free for good</b><span>No paid tier and no trial. The code will be open source, so it stays free.</span></li>
          <li><b>Works offline</b><span>Design, animate and export with no internet connection.</span></li>
          <li>
            <b>No account, no tracking</b><span>No telemetry and zero tracking or reporting: no sign-up, analytics or crash
            reports. Nothing about you or your work is sent anywhere.</span>
          </li>
        </ul>
        <p class="caveat">
          Emaki goes online only when you ask it to: for the Google Fonts tab in the font picker, or to import a frame
          from Figma. Projects are plain folders on your computer, with autosave and version history.
          <a href="/privacy">Privacy</a>
        </p>

        <div class="release">
          <div>
            <p class="release-line">
              Linux now, with Mac and Windows on the way
              {RELEASES_URL && <a href={RELEASES_URL}>All releases</a>}
            </p>
            <Cta />
          </div>
          <p class="release-links">
            <a href="/get-started">Get started</a>
            <a href="/faq">FAQ</a>
            <a href="/roadmap">Roadmap</a>
          </p>
        </div>
        <p class="next">
          Next on the roadmap: one design in every shape at once, templates filled in from a spreadsheet, automatic captions and motion that follows the music.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Hero: headline left, the lede and actions right, the scroll below. */
  .hero {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(64px, 9vw, 128px);
    overflow: hidden;
  }
  .hero-copy {
    display: grid;
    gap: 24px 64px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .hero-copy {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .hero h1 {
    margin: 0;
    max-width: 12ch;
  }
  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0 0 24px;
  }
  .hero-view {
    width: min(100% - 2.5rem, 1320px);
    margin: clamp(40px, 6vw, 64px) auto 0;
  }

  /* Scenes */
  .scene {
    padding-block: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--border);
  }
  .head {
    margin-bottom: clamp(32px, 5vw, 48px);
  }
  .head h2 {
    margin: 0;
    max-width: 18ch;
  }
  .head.split {
    display: grid;
    gap: 16px 64px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .head.split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .head.split > p {
    margin: 0;
    color: var(--text-dim);
  }

  /* The editor, with numbered pins and a legend that follows the window's layout. */
  .pinned {
    position: relative;
  }
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--bg) 70%, transparent);
  }
  /* On phones the whole window would shrink its text below 11 px, so show the
     canvas at full size instead, and the legend without the pin numbers. */
  .pinned-phone {
    display: none;
  }
  @media (max-width: 600px) {
    .pinned {
      display: none;
    }
    .pinned-phone {
      display: block;
    }
    .legend li {
      display: block;
    }
    .legend li::before {
      display: none;
    }
  }
  .legend {
    list-style: none;
    counter-reset: part;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .legend li {
    counter-increment: part;
    display: grid;
    grid-template-columns: 24px 1fr;
    column-gap: 12px;
  }
  .legend li::before {
    content: counter(part);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
  }
  .legend h3 {
    margin: 0 0 4px;
  }
  .legend p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }

  /* Made in Emaki: the clips side by side like panels on a scroll. */
  .strip {
    --h: clamp(240px, 32vw, 400px);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 16px;
  }
  .strip:focus-visible {
    outline-offset: -2px;
  }
  .strip ul {
    display: flex;
    gap: 16px;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0 max(1.25rem, (100vw - var(--wrap)) / 2);
  }
  .strip li {
    flex: none;
    width: calc(var(--h) * var(--ar));
    scroll-snap-align: center;
  }
  .clip-meta {
    font-variant-numeric: tabular-nums;
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .clip-meta span {
    color: var(--text);
    font-weight: 500;
    margin-right: 8px;
  }

  /* What's inside: one catalogue, the words on the left and the evidence on the right. */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    gap: 24px 64px;
    align-items: center;
    padding-block: 40px;
    border-top: 1px solid var(--border);
  }
  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .kind {
    margin: 0 0 8px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .row h3 {
    font-family: var(--font-head);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }
  .row-copy p:last-child {
    margin: 0;
    color: var(--text-dim);
  }
  .list {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }
  .list li {
    counter-increment: step;
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
  }
  .list.numbered li::before {
    content: counter(step);
    flex: none;
    width: 16px;
    color: var(--text-muted);
  }
  .formats {
    margin: 0;
    border-top: 1px solid var(--border-strong);
  }
  .formats > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 4px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .formats dt {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-top: 6px;
  }
  .formats dd {
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .formats b {
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .formats span {
    font-size: 0.9375rem;
    color: var(--text-dim);
  }
  @media (max-width: 480px) {
    .formats > div {
      grid-template-columns: 1fr;
    }
    .formats dt {
      padding-top: 0;
    }
  }
  .tracked {
    margin: 0;
  }
  .tracked figcaption {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .also {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border-strong);
  }
  .also h3 {
    margin-bottom: 24px;
  }
  .also dl {
    display: grid;
    gap: 24px 32px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    margin: 0 0 32px;
  }
  .also dt {
    font-weight: 500;
    margin-bottom: 4px;
  }
  .also dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }
  .small {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* The name, told on the scroll, then the story. */
  .meaning {
    padding-bottom: clamp(32px, 5vw, 64px);
  }
  .meaning-head h2 {
    margin: 0;
  }
  .hint {
    margin-top: 0;
    margin-bottom: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .story-grid {
    display: grid;
    gap: 24px 64px;
  }
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .story-grid h2 {
    max-width: 14ch;
  }
  .story-copy {
    max-width: 40rem;
  }
  .story-copy p {
    color: var(--text-dim);
  }
  .story-copy .pull {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    color: var(--text);
    margin: 32px 0;
  }
  .contribute {
    margin: 0;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }
  .contribute a {
    margin-left: 4px;
  }

  /* Get Emaki */
  .get h2 {
    max-width: 20ch;
  }
  .terms {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    gap: 0 48px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    grid-auto-rows: auto;
  }
  .terms li {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--text);
