---
// The roadmap as a timeline: the playhead sits at Now, Next runs on from it,
// and Later fades out to the right, where plans are least certain.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { roadmap } from '../data/roadmap';
import { GITHUB_URL } from '../config';
---

<Base
  title="Roadmap: Emaki"
  description="Where Emaki, the desktop motion design app, is going: what's being worked on now, what's next and what's later."
>
  <SiteHeader />
  <main id="main">
    <div class="wrap head">
      <h1>Where Emaki is going</h1>
      <p>
        What’s being worked on, what’s planned and the bigger ideas. There are no dates, and plans change as people use
        the app.
      </p>
    </div>

    <div class="wrap line">
      <div class="ruler" aria-hidden="true">
        <span class="playhead"></span>
      </div>
      <div class="groups">
        {
          roadmap.map((g) => (
            <section class:list={['group', g.id]} id={g.id} aria-labelledby={`${g.id}-title`}>
              <div class="group-head">
                <h2 id={`${g.id}-title`}>{g.title}</h2>
                <p>{g.note}</p>
              </div>
              <ul class="items">
                {g.items.map((i) => (
                  <li>
                    <h3>{i.title}</h3>
                    <p>{i.text}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    <section class="wrap idea" aria-labelledby="idea-title">
      <h2 id="idea-title">Have an idea?</h2>
      <p>
        Once the code is public, ideas, issues and contributions are all welcome.
        {GITHUB_URL ? <a href={GITHUB_URL}>Join in on GitHub</a> : <a href="/contributing">How contributing will work</a>}
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .head {
    display: grid;
    gap: 16px 64px;
    align-items: end;
    padding-block: clamp(48px, 8vw, 96px) clamp(40px, 6vw, 64px);
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .head h1,
  .head p {
    margin: 0;
  }
  .head p {
    color: var(--text-dim);
  }

  /* One ruler across all three groups: solid ticks for Now and Next, fading ones for Later. */
  .line {
    --cols: 1fr 2fr 1fr;
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .ruler {
    position: relative;
    height: 16px;
    background:
      repeating-linear-gradient(90deg, var(--text-muted) 0 1px, transparent 1px 64px) 0 100% / 75% 12px no-repeat,
      repeating-linear-gradient(90deg, var(--border-strong) 0 1px, transparent 1px 16px) 0 100% / 75% 6px no-repeat,
      linear-gradient(var(--text-muted), var(--text-muted)) 0 100% / 75% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--border-strong) 0 4px, transparent 4px 10px) 75% 100% / 25% 1px no-repeat;
    mask-image: linear-gradient(90deg, #000 75%, transparent);
  }
  .playhead {
    position: absolute;
    left: 0;
    top: -8px;
    bottom: -12px;
    width: 2px;
    background: var(--shu);
  }
  .playhead::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0;
    width: 12px;
    height: 10px;
    border-radius: 3px 3px 6px 6px;
    background: var(--shu);
  }
  .groups {
    display: grid;
    grid-template-columns: var(--cols);
  }
  .group {
    padding: 24px 32px 0 16px;
    border-left: 1px solid var(--border-strong);
  }
  .group.now {
    border-left-color: var(--shu);
  }
  .group.later {
    border-left-style: dashed;
    padding-right: 0;
  }
  .group-head {
    margin-bottom: 24px;
  }
  .group-head h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 4px;
  }
  .group-head p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .next .items {
    grid-template-columns: 1fr 1fr;
    gap: 20px 32px;
  }
  .items h3 {
    margin-bottom: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .items p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .later .items p,
  .later .items h3 {
    color: var(--text-dim);
  }

  @media (max-width: 960px) {
    .ruler {
      display: none;
    }
    .groups {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .group {
      padding: 0 0 0 20px;
    }
    .next .items {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    }
  }

  .idea {
    padding-block: 32px clamp(48px, 8vw, 96px);
    border-top: 1px solid var(--border);
  }
  .idea h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .idea p {
    margin: 0;
    color: var(--text-dim);
  }
</style>
