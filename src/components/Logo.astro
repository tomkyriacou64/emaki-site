---
// The horizontal Emaki logo, inlined so the wordmark follows the text colour
// (ink in light mode, cream in dark mode) and the ribbons can draw on.
import raw from '../assets/brand/logo-horizontal.svg?raw';

interface Props {
  /** Gradient id prefix; must be unique per logo on the page. */
  id: string;
  /** Play the ribbon draw-on animation (skipped with reduced motion). */
  animate?: boolean;
  class?: string;
  height?: number;
}

const { id, animate = false, class: className = '', height = 40 } = Astro.props;

let ribbon = 0;
const svg = raw
  .replace(/<svg [^>]*>/, '')
  .replace('</svg>', '')
  .replaceAll('id="eb"', `id="${id}-b"`)
  .replaceAll('id="ef"', `id="${id}-f"`)
  .replaceAll('url(#eb)', `url(#${id}-b)`)
  .replaceAll('url(#ef)', `url(#${id}-f)`)
  // Ribbons (back, front, highlight) get pathLength so CSS can draw them on; the droplet pops in.
  .replace(/<path d="M (?=[^"]*" fill="none")/g, () => `<path class="ribbon r${ribbon++}" pathLength="1" d="M `)
  .replace(/<circle /, '<circle class="drop" ')
  .replace('fill="#1E1B2E"', 'fill="currentColor" class="word"');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 571.9 154"
  height={height}
  width={Math.round((height * 571.9) / 154)}
  class:list={['logo', className, { animate }]}
  role="img"
  aria-label="Emaki"
  set:html={svg}
/>

<style>
  .logo {
    display: block;
    width: auto;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .animate :global(.ribbon) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }
    .animate :global(.r1) { animation-delay: 0.15s; }
    .animate :global(.r2) { animation-delay: 0.9s; animation-duration: 0.5s; }
    .animate :global(.drop) {
      transform-box: fill-box;
      transform-origin: center;
      animation: pop 0.5s 1.05s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .animate :global(.word) {
      animation: fade 0.6s 0.5s ease-out backwards;
    }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { transform: scale(0); } }
  @keyframes fade { from { opacity: 0; transform: translateX(-6px); } }
</style>
