---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { roadmap } from '../data/roadmap';
import { GITHUB_URL } from '../config';
---

<Base
  title="Roadmap: Emaki"
  description="Where Emaki, the desktop motion design app, is going: what's being worked on now, what's next and what's later."
>
  <SiteHeader />
  <main id="main" class="wrap page-body">
    <div class="page-head">
      <h1>Where Emaki is going</h1>
      <p>
        What’s being worked on, what’s planned and the bigger ideas. There are no dates, and plans change as people
        use the app.
      </p>
    </div>

    {
      roadmap.map((g) => (
        <section class="group" id={g.id} aria-labelledby={`${g.id}-title`}>
          <div class="group-head">
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            <p>{g.note}</p>
          </div>
          <ul class:list={['items', g.id]}>
            {g.items.map((i) => (
              <li>
                <h3>{i.title}</h3>
                <p>{i.text}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="idea" aria-labelledby="idea-title">
      <h2 id="idea-title">Have an idea?</h2>
      <p>
        Once the code is public, ideas, issues and contributions are all welcome.
        {GITHUB_URL && <a href={GITHUB_URL}>Join in on GitHub</a>}
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .group {
    display: grid;
    gap: 24px 64px;
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 860px) {
    .group {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
    .group-head {
      position: sticky;
      top: 32px;
      align-self: start;
    }
  }
  .group-head h2 {
    margin-bottom: 4px;
  }
  .group-head p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 32px 32px;
  }
  .items li {
    padding-top: 12px;
    border-top: 1px solid var(--border-strong);
  }
  .items.now li {
    border-top: 2px solid var(--accent);
    padding-top: 11px;
  }
  .items.later li {
    border-top-style: dashed;
  }
  h3 {
    margin-bottom: 4px;
  }
  .items p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }
  .idea {
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .idea h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .idea p {
    margin: 0;
    color: var(--text-dim);
  }
</style>
