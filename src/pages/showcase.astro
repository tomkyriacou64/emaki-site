---
import Page from '../layouts/Page.astro';
import Clip from '../components/Clip.astro';
import { showcaseOrder, byFile } from '../data/showcase';

const clips = showcaseOrder.map(byFile);
---

<Page
  title="Showcase"
  description="Short looping clips made in Emaki, the desktop motion design app: menu boards, social posts, kinetic type and a logo reveal."
  heading="Made in Emaki"
>
  <p slot="intro">
    Seven built-in templates, exported with Emaki 0.9.2 and only made smaller for the web. Each one opens in the app
    with its timing in place, ready for your own words and colours.
  </p>

  <div class="grid">
    {clips.map((c) => <Clip clip={c} />)}
  </div>

  <p class="foot-note">
    Exported as MP4 with <code>emaki --export</code>. In the app you can also export WebM,
    ProRes 4444 with transparency, GIF, Lottie and PNG. <a href="/use-cases">What each kind of clip is for</a>
  </p>
</Page>

<style>
  .grid {
    display: grid;
    gap: clamp(32px, 4vw, 48px) 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .grid > :global(.wide) {
      grid-column: span 3;
    }
    .grid > :global(.tall) {
      grid-column: span 2;
    }
    .grid > :global(.square) {
      grid-column: span 2;
    }
  }
  .foot-note {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    max-width: 46rem;
  }
</style>
