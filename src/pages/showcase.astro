---
import { url } from '../lib/url';
// Showcase: what you can make in Emaki, by where it plays. Each use case is a
// band with its real clips hung at their true shape (every clip in a row at
// one height), then what in the app it leans on. Replaces the old Showcase and
// Use cases pages; /use-cases redirects here (astro.config.mjs).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Clip from '../components/Clip.astro';
import Shot from '../components/Shot.astro';
import { byFile } from '../data/showcase';
import mockups from '../assets/shots/mockups.png';

const cases = [
  {
    id: 'signage',
    band: 'band-kurotobi',
    time: '0:05',
    kind: 'Digital signage',
    title: 'Menu boards on a loop, from opening to close',
    text: 'Menu boards, window screens and waiting-room loops. Design in landscape or portrait at the screen’s own size, set the length, and export a video that loops cleanly on a media player.',
    specs: [
      'Menu board templates in landscape and portrait, plus multi-screen sets such as a drive-thru pair and a four-screen counter wall',
      'Preview the design on a TV mockup, turned either way, as you edit',
      'Export MP4 for players and screens, or a PNG for a still board',
    ],
    clips: ['morning-coffee', 'noodle-bar'],
  },
  {
    id: 'social',
    band: 'band-paper',
    time: '0:12',
    kind: 'Social media',
    title: 'Posts and stories at the right size',
    text: 'Start from a square post or a vertical story, or put story, square and landscape artboards side by side in one project.',
    specs: [
      'Animate a headline by letter, word or line',
      'Export sizes made for the platform you post to, with a note when the shape doesn’t match',
      'GIF to drop into a group chat, MP4 or WebM for the feed',
    ],
    clips: ['social-post', 'vertical-story'],
  },
  {
    id: 'events',
    band: 'band-binro',
    time: '0:20',
    kind: 'Brands and events',
    title: 'Logo reveals and title cards for the big screen',
    text: 'Logo reveals, title cards and stage loops. Play an artboard full screen from the editor, or export it for the venue’s playback.',
    specs: [
      'Logo reveal, mask reveal and kinetic type templates to start from',
      'ProRes 4444 with a transparent background, to sit over a camera feed or other video',
      'Sound from audio and video layers mixed into the export',
    ],
    clips: ['logo-reveal', 'mask-reveal'],
  },
  {
    id: 'demos',
    band: 'band-zoge',
    time: '0:28',
    kind: 'Product demos and video',
    title: 'An app at work, or a design pinned into footage',
    text: 'Paste screens in from Figma with the plugin, animate them, and show the result on a live phone or laptop mockup. Or pin a layer into a video with motion tracking.',
    specs: [
      'Phone and laptop mockups showing the artboard at the frame you’re editing',
      'Motion tracking and corner pin to put a design onto a screen in a video',
      'Lottie, so the animation ships inside your app or site and stays sharp at any size',
    ],
    clips: ['price-tag-tracking'],
    shot: true,
  },
].map((c) => ({ ...c, clips: c.clips.map(byFile) }));
---

<Base
  title="Showcase: what you can make in Emaki"
  description="Clips made in Emaki, the desktop motion design app, by where they play: menu boards for café screens, social posts and stories, logo reveals and title cards, and a design pinned into video with motion tracking."
>
  <SiteHeader />
  <main id="main">
    <div class="wrap page-head split">
      <h1>What you can make</h1>
      <p>
        Every clip here was made in Emaki: built-in templates, plus a price tag pinned with motion tracking, only made
        smaller for the web. Each template opens in the app with its timing in place, waiting for your own words.
      </p>
    </div>

    {
      cases.map((c) => (
        <section class:list={['case band', c.band]} id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="wrap">
            <div class="case-text">
              <div>
                <p class="mark">
                  <time>{c.time}</time> {c.kind}
                </p>
                <h2 id={`${c.id}-title`}>{c.title}</h2>
              </div>
              <div>
                <p>{c.text}</p>
                <ul class="specs">
                  {c.specs.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class:list={['hang', { 'with-shot': c.shot }]}>
              {c.shot && (
                <figure class="item shot-item" style="--ar: 1.6">
                  <Shot
                    src={mockups}
                    sizes="(min-width: 1200px) 640px, 100vw"
                    alt="Emaki with a vertical sale story artboard beside the same design on a phone mockup, both at the same frame."
                  />
                  <figcaption class="plaque">
                    <b>Phone mockup</b>
                    <span>A sale story beside the same design on a live phone mockup, in the editor.</span>
                  </figcaption>
                </figure>
              )}
              {c.clips.map((clip) => (
                <div
                  class:list={['item', clip.height > clip.width ? 'tall' : clip.height === clip.width ? 'square' : 'wide']}
                  style={`--ar: ${clip.width / clip.height}`}
                >
                  <Clip clip={clip} caption={false} />
                  <p class="plaque">
                    <b>{clip.title}</b>
                    <span>{clip.caption}</span>
                    <span class="meta">
                      {clip.width} × {clip.height}
                    </span>
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <p class="wrap foot-note">
      These were saved as MP4 video. The app can also save WebM, ProRes 4444 with a transparent background, GIF,
      Lottie and PNG. <a href={url('/#inside')}>See what's inside the app</a>
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  .case {
    padding-block: var(--band-y);
  }
  .case-text {
    display: grid;
    gap: var(--s-4) var(--col-gap);
    margin-bottom: var(--head-gap);
  }
  @media (min-width: 900px) {
    .case-text {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .case-text h2 {
    margin: 0;
    max-width: 18ch;
  }
  .case-text p {
    margin: 0;
    color: var(--text-dim);
    max-width: 40rem;
  }
  .specs {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }
  .specs li {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text-dim);
  }

  /* The clips in one row, each as wide as its shape needs at the row's height. */
  .hang {
    display: flex;
    gap: var(--grid-gap);
    align-items: flex-start;
  }
  .item {
    flex: var(--ar) 1 0%;
    min-width: 0;
    margin: 0;
  }
  .plaque {
    display: grid;
    gap: 4px;
    margin: var(--caption-gap) 0 0;
    max-width: 40ch;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-dim);
  }
  .plaque b {
    font-weight: 500;
    color: var(--text);
  }
  .meta {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 700px) {
    .hang {
      flex-direction: column;
      gap: var(--s-6);
    }
    .item {
      flex: none;
      width: 100%;
    }
    .item.tall {
      width: 64%;
    }
    .item.square {
      width: 86%;
    }
  }

  .foot-note {
    padding-block: var(--s-6) var(--band-y);
    margin-block: 0;
    color: var(--text-dim);
  }
</style>
