---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Shot from '../components/Shot.astro';
import Feature from '../components/Feature.astro';
import Icon from '../components/Icon.astro';
import HeroScroll from '../components/HeroScroll.astro';
import Cta from '../components/Cta.astro';
import { GITHUB_URL, RELEASES_URL, FIGMA_PLUGIN_URL } from '../config';

import editor from '../assets/shots/hero-editor.png';
import artboards from '../assets/shots/artboards.png';
import graph from '../assets/shots/graph-editor.png';
import textPath from '../assets/shots/text-path.png';
import mockups from '../assets/shots/mockups.png';
import colour from '../assets/shots/colour.png';
import templates from '../assets/shots/templates.png';
import exportShot from '../assets/shots/export.png';

const formats = [
  { name: 'MP4', note: 'H.264, for sharing anywhere' },
  { name: 'WebM', note: 'small files for the web' },
  { name: 'ProRes 4444', note: 'with transparency, for editing' },
  { name: 'GIF', note: 'for chats and docs' },
  { name: 'Lottie', note: 'vector animation for apps and sites' },
  { name: 'PNG', note: 'a single frame or a sequence' },
];

const more = [
  { icon: 'mask', title: 'Masks', text: 'Clip layers to a shape, then animate the shape to reveal them.' },
  { icon: 'history', title: 'Version history', text: 'Save named versions of a project and go back to any of them.' },
  { icon: 'palette', title: 'Brand kits', text: 'Colours, text styles, logos and fonts, ready in every project.' },
  { icon: 'component', title: 'Components', text: 'Make a layer a component and place live copies, each with its own timing.' },
  { icon: 'music', title: 'Audio and video', text: 'Trim clips on the timeline and hear the sound as you preview.' },
  { icon: 'target', title: 'Motion tracking', text: 'Pin a layer to a point in a video, or put a design on a moving screen.' },
  { icon: 'sparkle', title: 'Effects', text: 'Blur, frosted glass, soft shadows, blend modes and colour keying.' },
  { icon: 'figma', title: 'Figma plugin', text: 'Copy frames in Figma and paste them in as layers, ready to animate.' },
] as const;

const storyPoints = [
  'Design and animate in one place',
  'Import from Figma with a plugin',
  'Motion tracking: pin layers to points in a video',
  'Timeline, keyframes and a graph editor',
  'Masks and text on a path',
  'Templates and live device mockups',
  'Export to video, GIF and Lottie',
  'Private and offline: no account, no tracking',
  'Completely free and open source',
];

---

<Base
  title="Emaki: motion design on your desktop"
  description="Emaki is a desktop app for motion design. Design on artboards, animate on a timeline and export to MP4, WebM, ProRes, GIF, Lottie or PNG. Local, no account. Free, and open source soon."
>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <p class="pill">Free · Open source soon · Linux first</p>
        <h1 id="hero-title">Motion design, on your desktop.</h1>
        <p class="lede">
          Emaki is a native app for designing and animating. Lay out a scene on artboards, bring it to life on a
          timeline, and export video, GIF or Lottie. It runs on your computer, with no account.
        </p>
        <Cta tour class="hero-cta" />
        <ul class="promises" aria-label="In short">
          <li><Icon name="check" size={18} /> Completely free and open source</li>
          <li><Icon name="user-off" size={18} /> No account, no tracking</li>
          <li><Icon name="wifi-off" size={18} /> Works fully offline</li>
        </ul>
      </div>
      <div class="wrap hero-scroll">
        <div class="glow" aria-hidden="true"></div>
        <HeroScroll />
      </div>
    </section>

    <section class="editor" aria-labelledby="editor-title">
      <div class="wrap">
        <div class="editor-head">
          <p class="eyebrow">The editor</p>
          <h2 id="editor-title">Everything in one window</h2>
          <p>
            Layers and assets on the left, the canvas in the middle, design and animation settings on the right, and
            the timeline along the bottom. Press <kbd>Space</kbd> and it plays, with sound.
          </p>
        </div>
        <Shot
          src={editor}
          sizes="(min-width: 1200px) 1160px, 100vw"
          alt="EDITOR_ALT"
        />
      </div>
    </section>

    <div class="wrap" id="features">
      <h2 class="visually-hidden">Features</h2>

      <Feature id="artboards" eyebrow="Design" title="Design on artboards" shot={artboards} alt="ARTBOARDS_ALT">
        <p>
          The canvas is endless. Add as many artboards as you need, each with its own size, background, frame rate and
          length.
        </p>
        <ul>
          <li>Shapes, a pen for paths, and rich text you edit right on the canvas.</li>
          <li>Import images, SVG as editable paths, video and audio.</li>
          <li>Smart guides, auto layout and measuring as you drag.</li>
        </ul>
      </Feature>

      <Feature id="animate" eyebrow="Animate" title="Presets, keyframes and easing" shot={graph} alt="GRAPH_ALT" flip>
        <p>
          Pick an animation from the gallery and it lands on the timeline, ready to retime. When you want more control,
          open it into keyframes.
        </p>
        <ul>
          <li>Drag segments to retime them and edges to change their length.</li>
          <li>Shape the easing of any keyframe in the graph editor.</li>
          <li>Bend a move into a curved path, or make a layer follow one.</li>
        </ul>
      </Feature>

      <Feature id="type" eyebrow="Type" title="Type that moves" shot={textPath} alt="TEXT_ALT">
        <p>Animate text by letter, word or line, set it along a path, and animate the axes of variable fonts.</p>
        <ul>
          <li>Text on a path, with the path still editable.</li>
          <li>Variable fonts, with weight and width you can keyframe.</li>
          <li>Your installed fonts, plus Google Fonts when you ask for them.</li>
        </ul>
      </Feature>

      <Feature id="mockups" eyebrow="Present" title="Device mockups, live" shot={mockups} alt="MOCKUPS_ALT" flip>
        <p>
          Show an artboard on a phone, laptop or TV. The mockup stays live, so every edit and every frame of the
          animation shows on the device as you work.
        </p>
      </Feature>

      <Feature id="colour" eyebrow="Colour" title="Colour adjustments and looks" shot={colour} alt="COLOUR_ALT">
        <p>
          Start from a look such as Warm, Faded or Teal and orange, then fine-tune it. Every thumbnail shows your own
          layer.
        </p>
        <ul>
          <li>Exposure, contrast, highlights and shadows.</li>
          <li>Saturation, vibrance, temperature and tint, plus curves.</li>
          <li>Compare before and after with a split view.</li>
        </ul>
      </Feature>

      <Feature id="templates" eyebrow="Start fast" title="Templates" shot={templates} alt="TEMPLATES_ALT" flip>
        <p>
          Animated starting points for social posts, logo reveals, lower thirds, kinetic type, vertical stories and
          menu boards. Swap the words and colours, and keep the motion.
        </p>
      </Feature>

      <Feature id="export" eyebrow="Export" title="Export anywhere" shot={exportShot} alt="EXPORT_ALT">
        <p>Export one artboard or all of them at once, at 1×, 2× or a size made for the platform you post to.</p>
        <ul class="formats" aria-label="Export formats">
          {
            formats.map((f) => (
              <li>
                <strong>{f.name}</strong>
                <span>{f.note}</span>
              </li>
            ))
          }
        </ul>
        <p class="note">Sound from audio and video layers is mixed into MP4, WebM and ProRes.</p>
      </Feature>

      <section class="more" aria-labelledby="more-title">
        <p class="eyebrow">And more</p>
        <h2 id="more-title">The rest of the toolbox</h2>
        <ul>
          {
            more.map((m) => (
              <li>
                <span class="more-icon">
                  <Icon name={m.icon} size={22} />
                </span>
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="more-note">
          The Figma plugin copies through your clipboard, so nothing leaves your computer.
          {
            FIGMA_PLUGIN_URL ? (
              <>
                For now you install it from <a href={FIGMA_PLUGIN_URL}>the repository</a> as a development plugin.
              </>
            ) : (
              <>It comes with the source code, to install as a development plugin.</>
            )
          }
        </p>
      </section>

      <Feature id="private" eyebrow="Yours" title="Private by design" flip>
        <p>
          Emaki runs on your computer. There is no account to make, nothing to sign in to and no tracking. Your
          projects stay on your disk, as plain folders you can back up, sync or share however you like.
        </p>
        <p>
          It works fully offline. It only goes online when you ask it to: for the Google Fonts tab in the font picker,
          or to import from Figma.
        </p>
        <ul class="cards" slot="aside">
          <li>
            <Icon name="user-off" size={22} />
            <strong>No account, no tracking</strong>
            <span>Open it and start. Nothing is collected.</span>
          </li>
          <li>
            <Icon name="wifi-off" size={22} />
            <strong>Works offline</strong>
            <span>Designing, animating and export need no network.</span>
          </li>
          <li>
            <Icon name="folder" size={22} />
            <strong>Plain files</strong>
            <span>A project is a folder with its media beside it.</span>
          </li>
          <li>
            <Icon name="history" size={22} />
            <strong>Safe by default</strong>
            <span>Autosave, crash recovery and version history.</span>
          </li>
        </ul>
      </Feature>
    </div>

    <section class="name" id="name" aria-labelledby="name-title">
      <div class="wrap name-grid">
        <div class="name-copy">
          <p class="eyebrow">The name</p>
          <h2 id="name-title">Emaki means picture scroll</h2>
          <p>
            <span lang="ja">絵巻</span>, short for <i>emakimono</i> (<span lang="ja">絵巻物</span>), are Japanese
            illustrated handscrolls. The form flourished from the 12th century, late in the Heian period. Among the
            best known are the Tale of Genji scrolls and the playful animals of the <i>Chōjū-jinbutsu-giga</i>.
          </p>
          <p>
            You read an emaki a little at a time, unrolling it from right to left and rolling up what you have seen.
            Scenes run into one another, so the story unfolds in time as the paper moves. A timeline in a motion editor
            does much the same, which is where the app takes its name.
          </p>
        </div>
        <dl class="gloss" lang="ja">
          <div>
            <dt>絵</dt>
            <dd lang="en-GB"><i>e</i> picture</dd>
          </div>
          <div>
            <dt>巻</dt>
            <dd lang="en-GB"><i>maki</i> scroll</dd>
          </div>
          <div>
            <dt>物</dt>
            <dd lang="en-GB"><i>mono</i> thing</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="story" id="story" aria-labelledby="story-title">
      <div class="wrap story-grid">
        <div class="story-copy">
          <p class="eyebrow">The story</p>
          <h2 id="story-title">Why I built it</h2>
          <p>
            I run a digital signage company. For years I made our content by designing in Figma, then animating it in
            Jitter. Jitter is good, but it was missing things I needed. I'm also a fan of open source, and none of the
            open-source tools ticked every box. So I built my own, starting while on honeymoon in Japan.
          </p>
          <p>
            Emaki is essentially Figma with animation, plus motion tracking. It's completely free and open source, so
            anyone can use it.
          </p>
          <p class="contribute">
            Contributors are very welcome to help make it great, once the code is public.
            {
              GITHUB_URL && (
                <>
                  {' '}
                  <a href={GITHUB_URL}>Contribute on GitHub</a>
                </>
              )
            }
          </p>
        </div>
        <ul class="story-list" aria-label="What Emaki does">
          {storyPoints.map((s) => (
            <li>
              <Icon name="check" size={18} />
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="next" aria-labelledby="next-title">
      <div class="wrap">
        <p class="eyebrow">Roadmap</p>
        <h2 id="next-title">Coming next</h2>
        <p class="next-note">Planned, not yet in the app. <a href="/roadmap">See the full roadmap</a></p>
        <ul>
          <li>
            <h3>One design, every format</h3>
            <p>Make story, square and landscape versions of an artboard in one step.</p>
          </li>
          <li>
            <h3>Data-driven templates</h3>
            <p>Load a spreadsheet and export one video per row.</p>
          </li>
          <li>
            <h3>Auto captions</h3>
            <p>Turn speech in a video into animated subtitles.</p>
          </li>
          <li>
            <h3>Audio-driven motion</h3>
            <p>Snap keyframes to the beat, or let loudness drive any property.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="get" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <div class="get-head">
          <p class="eyebrow">Get Emaki</p>
          <h2 id="get-title">Free, and open source soon</h2>
          <p>
            Emaki is nearly ready. It's completely free, and its code will be public soon under the MIT and Apache 2.0
            licences. No account, no tracking, and your projects stay on your computer.
          </p>
          <Cta />
        </div>

        <div class="platforms">
          <div class="platform first">
            <h3>Linux <span class="tag">First</span></h3>
            <p>One AppImage for 64-bit distributions, with FFmpeg included.</p>
            {
              RELEASES_URL && (
                <p class="small">
                  <a href={RELEASES_URL}>All releases</a>
                </p>
              )
            }
          </div>
          <div class="platform">
            <h3>macOS <span class="tag soon">Later</span></h3>
            <p>For Apple silicon and Intel Macs.</p>
          </div>
          <div class="platform">
            <h3>Windows <span class="tag soon">Later</span></h3>
            <p>For 64-bit Windows.</p>
          </div>
        </div>

        <div class="reqs">
          <h3>What it needs on Linux</h3>
          <ul>
            <li>
              <Icon name="check" size={18} />
              <span>A graphics card with Vulkan support. Emaki draws and exports on the GPU.</span>
            </li>
            <li>
              <Icon name="check" size={18} />
              <span>Wayland or X11, and glibc 2.30 or newer (Ubuntu 20.04 and later, or similar).</span>
            </li>
            <li>
              <Icon name="check" size={18} />
              <span>Nothing else: FFmpeg is bundled, so every export format works out of the box.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(2rem, 6vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero-copy {
    text-align: center;
    max-width: 52rem;
  }
  .pill {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
  }
  .promises {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-dim);
  }
  .promises li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .promises :global(svg) {
    color: var(--accent);
  }
  .lede {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    color: var(--text-dim);
    max-width: 40rem;
    margin: 1rem auto 2rem;
  }
  .hero-copy :global(.hero-cta) {
    justify-content: center;
  }
  .hero-scroll {
    position: relative;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .glow {
    position: absolute;
    inset: -10% 2% 0;
    background:
      radial-gradient(closest-side at 18% 40%, color-mix(in srgb, var(--pink) 70%, transparent), transparent),
      radial-gradient(closest-side at 50% 25%, color-mix(in srgb, var(--lilac) 55%, transparent), transparent),
      radial-gradient(closest-side at 82% 50%, color-mix(in srgb, var(--peri) 70%, transparent), transparent),
      radial-gradient(closest-side at 45% 80%, color-mix(in srgb, var(--mint) 50%, transparent), transparent);
    filter: blur(48px);
    opacity: 0.7;
    z-index: 0;
  }
  @media (prefers-color-scheme: dark) {
    .glow {
      opacity: 0.3;
    }
  }
  .hero-scroll :global(.scroll) {
    z-index: 1;
  }

  /* The editor */
  .editor {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .editor-head {
    max-width: 42rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .editor-head p:not(.eyebrow) {
    color: var(--text-dim);
  }

  #features {
    border-top: 1px solid var(--border);
  }

  /* Formats */
  .formats {
    list-style: none;
    padding: 0 !important;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.5rem;
    margin: 1.25rem 0 1rem !important;
  }
  .formats li {
    margin: 0 !important;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .formats strong {
    color: var(--text);
    font-size: 0.95rem;
  }
  .formats span {
    font-size: 0.85rem;
  }
  .note {
    font-size: 0.92rem;
  }

  :global(kbd) {
    font-family: inherit;
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text);
  }

  /* And more */
  .more {
    border-top: 1px solid var(--border);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .more ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .more li {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .more h3 {
    margin: 0.85rem 0 0.35rem;
  }
  .more li p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .more-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .more-note {
    margin: 1.5rem 0 0;
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  /* Privacy cards */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .cards li {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cards :global(svg) {
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .cards span {
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  /* The name */
  .name {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .name-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .name-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
  }
  .name-copy p:not(.eyebrow) {
    color: var(--text-dim);
    max-width: 38rem;
  }
  .name-copy p:not(.eyebrow) [lang='ja'] {
    color: var(--text);
  }
  .gloss {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    border-block: 6px solid color-mix(in srgb, var(--peri) 50%, var(--surface));
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .gloss div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .gloss dt {
    font-family: 'Noto Serif CJK JP', 'Noto Serif JP', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
    color: var(--text);
  }
  .gloss dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-dim);
    text-align: center;
  }
  .gloss dd i {
    display: block;
    font-style: normal;
    font-weight: 600;
    color: var(--text);
  }

  /* The story */
  .story {
    padding-block: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
  }
  .story-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .story-copy p:not(.eyebrow) {
    color: var(--text-dim);
    max-width: 38rem;
  }
  .contribute {
    padding-left: 1rem;
    border-left: 3px solid color-mix(in srgb, var(--pink) 70%, var(--border));
  }
  .story-list {
    list-style: none;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: grid;
    gap: 0.6rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .story-list li {
    display: flex;
    gap: 0.6rem;
    font-weight: 500;
  }
  .story-list :global(svg) {
    color: var(--accent);
    margin-top: 0.3rem;
    flex: none;
  }

  /* Coming next */
  .next {
    border-block: 1px solid var(--border);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .next-note {
    color: var(--text-dim);
  }
  .next ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .next li {
    padding: 1.25rem;
