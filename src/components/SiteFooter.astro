---
// The footer on every page: the logo, then the site in three short lists.
import Logo from './Logo.astro';
import { GITHUB_URL, LICENCE_URL } from '../config';

const year = new Date().getFullYear();
const groups = [
  {
    title: 'Emaki',
    links: [
      { href: '/#inside', label: 'Features' },
      { href: '/showcase', label: 'Showcase' },
      { href: '/get-started', label: 'Get started' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/#name', label: 'The name' },
      { href: '/roadmap', label: 'Roadmap' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/contributing', label: 'Contributing' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/licence', label: 'Licence and credits' },
      ...(GITHUB_URL ? [{ href: GITHUB_URL, label: 'GitHub' }] : []),
    ],
  },
];
---

<footer class="foot band band-sumi">
  <div class="wrap foot-grid">
    <div class="about">
      <Logo id="logo-foot" height={28} />
      <p>A desktop app for designing and animating motion graphics. Its name means picture scroll: the Japanese handscroll that tells a story a scene at a time.</p>
    </div>
    {
      groups.map((g) => (
        <nav aria-label={g.title}>
          <h2>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap legal">
    <p>
      {LICENCE_URL ? <a href={LICENCE_URL}>Code: MIT or Apache-2.0</a> : 'Open source soon, under MIT or Apache-2.0'} · © {year} Emaki ·
      This site uses no cookies and no analytics.
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    padding-block: clamp(2rem, 5vw, 3rem) 2rem;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }
  .foot-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  @media (min-width: 860px) {
    .foot-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
  .about p {
    margin: 12px 0 0;
    max-width: 22rem;
  }
  h2 {
    font-family: var(--font-text);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text);
    margin: 0 0 12px;
  }
  ul {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--text-dim);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
  }
  .legal p {
    margin: 0;
  }
</style>
