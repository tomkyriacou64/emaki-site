---
import { url } from '../lib/url';
// The landing page, read like a scroll: each section is a scene, marked on a
// small timeline ruler (`.mark`) with its timecode. One fixed look in bands:
// the dark hero, warm light bands, and a dark closing band (see global.css).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Shot from '../components/Shot.astro';
import Crop from '../components/Crop.astro';
import Cta from '../components/Cta.astro';
import Clip from '../components/Clip.astro';
import Icon from '../components/Icon.astro';
import Emakimono from '../components/Emakimono.astro';
import { byFile } from '../data/showcase';
import { GITHUB_URL, RELEASES_URL, FIGMA_PLUGIN_URL, NOTIFY_URL, APPIMAGE_URL } from '../config';

import editor from '../assets/shots/mockups.png';
import graph from '../assets/shots/graph-editor.png';
import textPath from '../assets/shots/text-path.png';
import colour from '../assets/shots/colour.png';
import imageEdit from '../assets/shots/image-edit.png';
// TODO(task 209): replace these two stand-ins with src/assets/shots/mode-design.png
// and src/assets/shots/mode-animate.png, then drop the crops in the modes section.
import modeDesign from '../assets/shots/artboards.png';
import modeAnimate from '../assets/shots/hero-editor.png';

// The clips on the home page; the showcase has them all.
const clips = ['morning-coffee', 'noodle-bar', 'social-post', 'mask-reveal'].map(byFile);
// On wide screens the clips hang in two rows, each row at one height.
const clipRows = [clips.slice(0, 2), clips.slice(2)];
const tracked = byFile('price-tag-tracking');

// The four parts of the editor window, pinned on the screenshot (x, y as % of it).
const parts = [
  { x: 12, y: 46, title: 'Layers', text: 'Shapes, text, images, video and sound, in groups and masks' },
  { x: 42, y: 13, title: 'Canvas', text: 'Artboards side by side, with live phone, laptop and TV mockups beside them' },
  { x: 88, y: 60, title: 'Inspector', text: 'Size, layout and styles, and in Animate the layer’s animations' },
  { x: 30, y: 88, title: 'Timeline', text: 'In Animate: drag a bar to retime it, or its edges to change its length' },
];

// Export formats, grouped by what they're for.
const formats = [
  { use: 'Stills', names: 'PNG', text: 'The design at rest, one frame, or every frame as a sequence' },
  { use: 'Screens and social', names: 'MP4 · WebM', text: 'For signage players, phones and social posts' },
  { use: 'Editing', names: 'ProRes 4444', text: 'Keeps the transparency, to lay over other footage' },
  { use: 'Web and apps', names: 'Lottie · GIF', text: 'Lottie stays sharp inside apps and sites; GIF for chats and docs' },
];

const also = [
  { title: 'Masks in motion', text: 'Animate a mask’s shape to reveal the layers it clips' },
  { title: 'Component timing', text: 'Each copy of a component can start at its own time' },
  { title: 'Colour keying', text: 'Key a colour out of an image or video, like a green screen' },
  { title: 'Audio and video', text: 'Trim clips on the timeline and hear the sound as you preview' },
  { title: 'Templates', text: 'Social posts, logo reveals, lower thirds, kinetic type, stories and menu boards' },
  { title: 'Figma plugin', text: 'Copy frames in Figma and paste them in as editable layers' },
];

// What "free" means, as a short list on the plan card.
const terms = [
  'Every feature, with no paid tier and no trial',
  'Design, animate and export with no internet connection',
  'No account, no analytics and no crash reports',
  'Projects are plain folders, with autosave and version history',
];

// Where to get it. Linux follows the same links as the call to action (a
// download once APPIMAGE_URL is set, else the notify sign-up); Mac and Windows
// have no builds yet, so they offer the sign-up or say "Coming soon".
const platforms = [
  {
    name: 'Linux',
    href: APPIMAGE_URL || NOTIFY_URL,
    label: APPIMAGE_URL ? 'Download' : NOTIFY_URL ? 'Get notified' : 'Coming soon',
    icon: APPIMAGE_URL ? 'download' : 'bell',
    primary: true,
  },
  { name: 'Mac', href: NOTIFY_URL, label: NOTIFY_URL ? 'Get notified' : 'Coming soon', icon: 'bell', primary: false },
  { name: 'Windows', href: NOTIFY_URL, label: NOTIFY_URL ? 'Get notified' : 'Coming soon', icon: 'bell', primary: false },
];---

<Base
  title="Emaki: a design tool and a motion editor in one free app"
  description="Emaki is a free desktop app for design and motion graphics. Lay out artboards, text, images and components in Design, then switch to Animate for a timeline with sound. Export PNG, MP4, WebM, ProRes, GIF or Lottie. Runs offline, with no account. Open source soon."
>
  <SiteHeader dark />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="band band-sumi hero-band">
        <div class="wrap hero-copy">
          <h1 id="hero-title">Design it. Animate it.</h1>
          <div class="hero-side">
            <p class="lede">
              Emaki is a free desktop app for social posts, menu boards, screen loops and logo reveals, still or
              moving. Lay out artboards in Design and export a PNG, or switch to Animate and give the same layers a
              timeline with sound. It runs on your own computer, offline, with no account.
            </p>
            <Cta tour />
          </div>
        </div>
      </div>

      <div class="hero-view">
        <div class="wrap pinned">
          <div class="tilt">
          <Shot
            src={editor}
            eager
            sizes="(min-width: 1224px) 1160px, 100vw"
            alt="The Emaki editor in its warm paper Washi theme: layers on the left, a weekend sale story artboard beside the same design on a phone mockup in the middle, the artboard's size and timing on the right, and the timeline with animation bars below."
          />
          {
            parts.map((p, i) => (
              <span class="pin" style={`left: ${p.x}%; top: ${p.y}%`} aria-hidden="true">
                {i + 1}
              </span>
            ))
          }
          </div>
        </div>
        <div class="wrap pinned-phone">
          <Crop
            src={editor}
            x={0.585}
            y={0.36}
            zoom={4.3}
            ratio={0.8}
            alt="The middle of the Emaki editor at full size: a vertical sale story artboard shown on a phone mockup."
          />
        </div>
      </div>

      <div class="band band-paper legend-band">
        <div class="wrap">
          <h2 class="visually-hidden">The editor window</h2>
          <ol class="legend">
            {
              parts.map((p) => (
                <li>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="scene band band-zoge modes" id="modes" aria-labelledby="modes-title">
      <div class="wrap">
        <div class="head split">
          <div>
            <p class="mark"><time>0:03</time> Design and Animate</p>
            <h2 id="modes-title">Two modes, one project</h2>
          </div>
          <p>
            A switch at the top of the window changes what the editor is for. Press <kbd>Ctrl</kbd>+<kbd>1</kbd> for
            Design and <kbd>Ctrl</kbd>+<kbd>2</kbd> for Animate. Still projects and templates open in Design; projects
            with animation open in Animate.
          </p>
        </div>

        <p class="switch" aria-hidden="true">
          <span class="seg seg-design">Design</span>
          <span class="seg seg-animate">Animate</span>
        </p>

        <div class="modes-grid">
          <article class="mode">
            <h3><span class="mode-name">Design · <kbd>Ctrl</kbd>+<kbd>1</kbd></span> Lay it out</h3>
            <p>
              A plain design tool. There’s no timeline, no edit ever adds a keyframe, and you see your design at rest.
              Layers that only appear later show as dashed outlines, so nothing is hidden from you.
            </p>
            <ul class="list" aria-label="In Design">
              <li>Artboards, shapes, pen paths and rich text</li>
              <li>Images, components, auto layout and masks</li>
              <li>PNG export of the design as it looks at rest</li>
            </ul>
            <!-- TODO(task 209): src/assets/shots/mode-design.png, the editor in Design. -->
            <Crop
              src={modeDesign}
              x={0.475}
              y={0.38}
              zoom={1.6}
              ratio={1.6}
              alt="The Emaki canvas with two artboards side by side, a landscape title card and a square card."
            />
          </article>

          <article class="mode">
            <h3><span class="mode-name">Animate · <kbd>Ctrl</kbd>+<kbd>2</kbd></span> Give it motion</h3>
            <p>
              The timeline comes back, and everything you laid out is waiting on it. Add presets, open them into
              keyframes, draw motion paths, add sound and preview it full screen.
            </p>
            <ul class="list" aria-label="In Animate">
              <li>Presets, keyframes and a graph editor for easing</li>
              <li>Motion paths, sound and full-screen preview</li>
              <li>Export to MP4, WebM, ProRes, GIF or Lottie</li>
            </ul>
            <!-- TODO(task 209): src/assets/shots/mode-animate.png, the editor in Animate. -->
            <Crop
              src={modeAnimate}
              x={0.475}
              y={0.8}
              zoom={1.6}
              ratio={1.6}
              alt="The Emaki timeline with animation bars for a card, a horizon and a line being drawn on, and the playhead at three seconds."
            />
          </article>
        </div>
      </div>
    </section>

    <section class="scene band band-kurotobi made" aria-labelledby="made-title">
      <div class="wrap">
        <div class="head split">
          <div>
            <p class="mark"><time>0:05</time> Made in Emaki</p>
            <h2 id="made-title">Every clip here is a built-in template</h2>
          </div>
          <p>
            Menu boards, a social post and a reveal, exported as they come with nothing touched up afterwards. Templates
            open in Design, so you can put in your own words and colours first; the timing is already done. <a href={url('/showcase')}>See them all</a>
          </p>
        </div>
      </div>
      <div class="wrap clip-rows">
        {
          clipRows.map((row) => (
            <ul class="clip-row">
              {row.map((c) => (
                <li style={`--ar: ${c.width / c.height}`}>
                  <Clip clip={c} caption={false} />
                  <p class="clip-meta">
                    <span>{c.title}</span> {c.width} × {c.height}
                  </p>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
      <div class="strip" role="region" aria-label="Clips made in Emaki" tabindex="0">
        <ul>
          {
            clips.map((c) => (
              <li style={`--ar: ${c.width / c.height}`}>
                <Clip clip={c} caption={false} />
                <p class="clip-meta">
                  <span>{c.title}</span> {c.width} × {c.height}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="scene band band-paper inside" id="inside" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="head">
          <p class="mark"><time>0:12</time> What’s inside</p>
          <h2 id="inside-title">Draw it, and time it if you want to</h2>
        </div>

        <ol class="rows timeline">
          <li class="row">
            <p class="key"><time>0:12</time> Design</p>
            <div class="row-copy">
              <h3>Artboards on an endless canvas</h3>
              <p>
                Each artboard has its own size, background, frame rate and length, and you can add as many as you need.
              </p>
            </div>
            <ul class="list" aria-label="Design tools">
              <li>Shapes, a pen for paths, and rich text you edit right on the canvas</li>
              <li>Images, SVG as editable paths, video and audio</li>
              <li>Smart guides and measuring as you drag</li>
              <li>Live phone, laptop and TV mockups beside your artboards</li>
            </ul>
          </li>

          <li class="row">
            <p class="key"><time>0:14</time> Layout</p>
            <div class="row-copy">
              <h3>Components, auto layout and masks</h3>
              <p>
                Make a layer a component and place live copies of it on any artboard. Auto layout arranges a group or an
                artboard in a row, a column or wrapping rows, with gaps and padding, and can hug what’s inside. A mask
                clips layers to a shape.
              </p>
            </div>
            <ul class="list" aria-label="Layout and styling">
              <li>Brand kits: colours, text styles, logos and fonts in every project</li>
              <li>Blur, frosted glass, soft shadows and blend modes</li>
              <li>Named versions of a project, to go back to any of them</li>
            </ul>
          </li>

          <li class="row">
            <p class="key"><time>0:16</time> Type</p>
            <div class="row-copy">
              <h3>Text on a path, by the letter or by the line</h3>
              <p>
                Set text along a path that stays editable, with the fonts on your computer, plus Google Fonts when you
                ask for them. In Animate, move it by the letter, word or line, or animate how bold or wide a font is, for
                fonts that can change.
              </p>
            </div>
            <Crop
              src={textPath}
              x={0.476}
              y={0.505}
              zoom={2.72}
              ratio={1.5}
              alt="Text set around a ring on a path, with a variable font at weight 537 in the middle."
            />
          </li>

          <li class="row">
            <p class="key"><time>0:18</time> Animate</p>
            <div class="row-copy">
              <h3>A gallery of presets, with keyframes underneath</h3>
              <p>
                Pick an animation from the gallery and it lands on the timeline as a bar you can drag. Open it into
                keyframes, shape any easing in the graph editor, bend a move into a curve, or make a layer follow a path.
              </p>
            </div>
            <Crop
              src={graph}
              x={0.788}
              y={0.872}
              zoom={2.42}
              ratio={2.83}
              alt="The graph editor beside the timeline, showing a card's X and Y position curves between its keyframes, with an easing handle pulled out."
            />
          </li>


        </ol>
      </div>
    </section>

    <section class="scene band band-binro footage" aria-labelledby="footage-title">
      <div class="wrap">
        <div class="head">
          <p class="mark"><time>0:20</time> Pictures and video</p>
          <h2 id="footage-title">Work on photos and footage</h2>
        </div>

        <ol class="rows">
          <li class="row">
            <div class="row-copy">
              <p class="kind"><time>0:21</time> Pictures</p>
              <h3>Edit pictures without leaving the canvas</h3>
              <p>
                Paint, select and adjust a picture where it sits. Remove its background or an object, fill from the
                surroundings, select the subject and straighten a photo’s perspective. Each edit stays a
                row you can hide, and you can copy edits from one picture to others. The tools that need a model
                download it once, then run on your computer.
              </p>
            </div>
            <Crop
              src={imageEdit}
              x={0.36}
              y={0.34}
              zoom={1.5}
              ratio={1.6}
              alt="A landscape picture being edited in Emaki: a lasso selection drawn around the sun on the canvas, with the picture tools in a bar below it."
            />
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind"><time>0:24</time> Colour</p>
              <h3>Grade with looks and curves</h3>
              <p>
                Start from a look such as Warm, Faded or Teal and orange, each previewed on your own layer. Adjust
                exposure, contrast, highlights, temperature and curves, and compare before and after in a split view.
              </p>
            </div>
            <Crop
              src={colour}
              x={0.66}
              y={0.5}
              zoom={1.45}
              alt="Four copies of a sunset photo graded differently, with the Looks menu open showing thumbnails such as Warm, Cool, Black and white and Faded."
            />
          </li>

          <li class="row">
            <div class="row-copy">
              <p class="kind"><time>0:27</time> Track</p>
              <h3>Pin a layer to something in a video</h3>
              <p>
                Motion tracking follows a point from frame to frame. Pin a layer to one point and it moves with it, or to
                two and it also scales and turns. Track a screen’s four corners and your design sits on it. If the
                tracker is unsure about a frame, it marks it for you to fix.
              </p>
            </div>
            <figure class="tracked">
              <Clip clip={tracked} caption={false} />
              <figcaption>
                Tracked in Emaki: the price tag is pinned to the cup’s handle and the spoon, so it moves, grows and turns
                with them. The footage is a drawn café table under a simulated handheld camera.
              </figcaption>
            </figure>
          </li>
        </ol>
      </div>
    </section>

    <section class="scene band band-zoge export" aria-labelledby="export-title">
      <div class="wrap">
        <div class="head split">
          <div>
            <p class="mark"><time>0:30</time> Export</p>
            <h2 id="export-title">Export stills, video, GIF or Lottie</h2>
          </div>
          <p>
            Export one artboard or all of them at once, at the size the place you post to expects. A PNG shows the design
            at rest or the frame at the playhead, and sound comes along in the video formats.
          </p>
        </div>

        <dl class="formats">
          {
            formats.map((f) => (
              <div>
                <dt>{f.use}</dt>
                <dd>
                  <b>{f.names}</b>
                  <span>{f.text}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="also">
          <h3>Also in the app</h3>
          <dl>
            {
              also.map((a) => (
                <div>
                  <dt>{a.title}</dt>
                  <dd>{a.text}</dd>
                </div>
              ))
            }
          </dl>
          <p class="small">
            The Figma plugin copies through your clipboard, so nothing leaves your computer.
            {
              FIGMA_PLUGIN_URL ? (
                <>
                  For now you install it from <a href={FIGMA_PLUGIN_URL}>the repository</a> as a development plugin.
                </>
              ) : (
                <> It comes with the source code, to install as a development plugin.</>
              )
            }
          </p>
        </div>
      </div>
    </section>

    <section class="scene band band-kogecha meaning" id="name" aria-labelledby="name-title">
      <Emakimono>
        <div slot="head" class="wrap meaning-head">
          <p class="mark"><time>0:34</time> The name</p>
          <h2 id="name-title">Emaki means picture scroll</h2>
        </div>
        <p slot="hint" class="wrap hint">Read it from right to left; scroll on or drag the paper to unroll it</p>
      </Emakimono>
    </section>

    <section class="scene band band-paper get" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <div class="head">
          <p class="mark"><time>0:41</time> Get Emaki</p>
          <h2 id="get-title">Free, and yours to keep</h2>
        </div>

        <div class="get-grid">
          <div class="plan">
            <p class="plan-name">What it costs</p>
            <p class="plan-price">Free</p>
            <ul class="plan-terms">
              {
                terms.map((t) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{t}</span>
                  </li>
                ))
              }
            </ul>
            <p class="caveat">
              It goes online only when you ask: for the Google Fonts tab in the font picker, or to import a frame from
              Figma. <a href={url('/privacy')}>Privacy</a>
            </p>
          </div>

          <div class="where">
            <h3>Where to get it</h3>
            <p class="where-lede">Emaki is coming soon to Linux, Mac and Windows, with Linux first</p>
            <ul class="platforms">
              {
                platforms.map((pl) => (
                  <li>
                    <span class="platform-name">{pl.name}</span>
                    {pl.href ? (
                      <a class:list={['btn', pl.primary ? 'btn-primary' : 'btn-secondary']} href={pl.href}>
                        <Icon name={pl.icon} />
                        {pl.label}
                      </a>
                    ) : (
                      <span class="btn btn-secondary is-off" aria-disabled="true">
                        {pl.label}
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
            <p class="get-links">
              <a href={url('/get-started')}>Get started</a>
              <a href={url('/faq')}>FAQ</a>
              <a href={url('/roadmap')}>Roadmap</a>
              {RELEASES_URL && <a href={RELEASES_URL}>All releases</a>}
            </p>
          </div>
        </div>

        <div class="open">
          <h3>The story</h3>
          <p>
            I run a digital signage company. For years I made our content by designing in Figma, then animating it in
            Jitter. Jitter is good, but it was missing things I needed. I'm also a fan of open source, and none of the
            open-source tools ticked every box. So I built my own, starting it while on honeymoon in Japan.
          </p>
          <p>
            Emaki is completely free, and its code will be open source soon. Once it's public, contributors are very
            welcome to help make it great.
            {
              GITHUB_URL ? (
                <a href={GITHUB_URL}>Contribute on GitHub</a>
              ) : (
                <a href={url('/contributing')}>How contributing will work</a>
              )
            }
          </p>
        </div>

        <p class="next">
          Next on the roadmap: one design in every shape at once, templates filled in from a spreadsheet, automatic
          captions and motion that follows the music.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Hero: headline left, the lede and actions right, the real editor below,
     sitting across the line where the dark band meets the light one. */
  .hero-band {
    padding-top: var(--group-gap);
    padding-bottom: var(--group-gap);
  }
  .hero-copy {
    display: grid;
    gap: var(--s-5) var(--col-gap);
    align-items: end;
  }
  @media (min-width: 960px) {
    .hero-copy {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .hero h1 {
    margin: 0;
    max-width: 15ch;
  }
  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0 0 var(--s-5);
  }
  /* Two flat bands with a hard edge, not a fade. */
  .hero-view {
    background: linear-gradient(var(--sumi) 0 55%, var(--shironeri) 55% 100%);
  }
  .hero-view :global(.shot) {
    border-color: rgb(252 250 242 / 0.12);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.2), 0 24px 48px rgb(0 0 0 / 0.24);
  }
  .legend-band {
    padding-block: var(--s-6) var(--band-y);
  }

  /* The editor rises and flattens as it scrolls into view, the way a canvas
     comes up when a project opens (a container scroll). Flat without scroll
     timelines or with reduced motion. */
  .tilt {
    position: relative;
    transform-origin: 50% 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 601px) and (max-height: 1400px) {
      .pinned {
        perspective: 1400px;
      }
      .tilt {
        animation: rise linear both;
      }
      /* The timeline in its own rule: the CSS minifier would fold it into the
         shorthand above, which browsers then reject. */
      .pinned .tilt {
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }
  @keyframes rise {
    from {
      transform: rotateX(22deg) scale(0.92);
    }
    to {
      transform: none;
    }
  }

  /* Scenes */
  .scene {
    padding-block: var(--band-y);
  }
  .head {
    margin-bottom: var(--head-gap);
  }
  .head h2 {
    margin: 0;
    max-width: 18ch;
  }
  .head.split {
    display: grid;
    gap: var(--s-4) var(--col-gap);
    align-items: end;
  }
  @media (min-width: 960px) {
    .head.split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .head.split > p {
    margin: 0;
    color: var(--text-dim);
  }

  /* The editor, with numbered pins and a legend that follows the window's layout. */
  .pinned {
    position: relative;
  }
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
