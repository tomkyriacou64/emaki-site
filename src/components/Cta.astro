---
// The main call to action. With NOTIFY_URL set it is a link to the sign-up
// page; without it, an honest status line and no button. A download button
// joins it once APPIMAGE_URL is set.
import Icon from './Icon.astro';
import { NOTIFY_URL, APPIMAGE_URL } from '../config';

interface Props {
  /** Show a secondary link to the showcase. */
  tour?: boolean;
  class?: string;
}

const { tour = false, class: className } = Astro.props;
---

<div class:list={['cta', className]}>
  {
    APPIMAGE_URL && (
      <a class="btn btn-primary" href={APPIMAGE_URL}>
        <Icon name="download" />
        Download for Linux <span class="btn-note">(AppImage)</span>
      </a>
    )
  }
  {
    NOTIFY_URL ? (
      <a class:list={['btn', APPIMAGE_URL ? 'btn-secondary' : 'btn-primary']} href={NOTIFY_URL}>
        <Icon name="bell" />
        Get notified when it’s out
      </a>
    ) : (
      !APPIMAGE_URL && (
        <p class="status">Coming soon to Linux</p>
      )
    )
  }
  {
    tour && (
      <a class="btn btn-secondary" href="/showcase">
        See what it makes
        <Icon name="arrow" size={18} />
      </a>
    )
  }
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .btn-note {
    font-weight: 400;
    opacity: 0.85;
  }
  /* While nothing can be downloaded, a plain status line, not a button. */
  .status {
    margin: 0;
    font-weight: 500;
    color: var(--text);
  }
</style>
