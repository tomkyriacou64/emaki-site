---
import { url, pagePath } from '../lib/url';
// The top bar on every page. On narrow screens the links that don't fit move
// into a menu behind one button. The button only appears once the script runs;
// without JavaScript those pages are still in the footer.
//
// It sticks to the top: at the very top it sits on its page as before; once
// scrolled it turns warm sumi with a hairline (one look over dark and light
// bands alike), slides away while you scroll down and comes back on any scroll
// up. It stays put while the menu is open or focus is inside it.
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  /** Sit on the dark hero band (home page). */
  dark?: boolean;
}
const { dark = false } = Astro.props;
const path = pagePath(Astro.url.pathname);
const links = [
  { href: url('/#inside'), label: 'Features', hide: 'narrow' },
  { href: url('/showcase'), label: 'Showcase', hide: 'tiny' },
  { href: url('/roadmap'), label: 'Roadmap', hide: 'narrow' },
  { href: url('/changelog'), label: 'Changelog', hide: 'narrow' },
  { href: url('/get-started'), label: 'Get started', button: true },
];
const more = links.filter((l) => l.hide);
---

<header class:list={['top band', dark ? 'band-sumi' : 'band-paper']} data-home-tone={dark ? 'band-sumi' : 'band-paper'}>
  <div class="wrap top-row">
    <a href={url('/')} class="brand" aria-label="Emaki home">
      <Logo id="logo-top" animate={path === '/'} height={36} />
    </a>
    <nav aria-label="Main" class="main-nav">
      <ul>
        {
          links.map((l) => (
            <li class:list={[l.hide]}>
              <a
                href={l.href}
                class:list={{ 'nav-btn': l.button }}
                aria-current={url(path) === l.href ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="menu-item">
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-more" hidden>
            <span class="icon-open"><Icon name="menu" /></span>
            <span class="icon-close"><Icon name="close" /></span>
            <span class="visually-hidden">More pages</span>
          </button>
        </li>
      </ul>
      <ul id="nav-more" class="more" hidden>
        {
          more.map((l) => (
            <li class:list={[`in-${l.hide}`]}>
              <a href={l.href} aria-current={url(path) === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('nav-more');
  if (btn && panel) {
    btn.hidden = false;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        btn.focus();
      }
    });
    // Close when focus or a click goes anywhere outside the button and the menu.
    const outside = (t: EventTarget | null) => !(t instanceof Node && (btn.contains(t) || panel.contains(t)));
    document.addEventListener('focusin', (e) => outside(e.target) && set(false));
    document.addEventListener('click', (e) => outside(e.target) && set(false));
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && set(false));
  }

  // Sticky: hide on the way down, show on any scroll up.
  const top = document.querySelector<HTMLElement>('header.top');
  if (top) {
    const tone = top.dataset.homeTone ?? 'band-paper';
    let last = scrollY;
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = Math.max(0, scrollY);
      const scrolled = y > top.offsetHeight;
      top.classList.toggle('is-scrolled', scrolled);
      top.classList.toggle('band-sumi', scrolled || tone === 'band-sumi');
      top.classList.toggle('band-paper', !scrolled && tone === 'band-paper');
      const delta = y - last;
      if (Math.abs(delta) < 6) return; // ignore jitter
      const busy = top.matches(':focus-within') || btn?.getAttribute('aria-expanded') === 'true';
      top.classList.toggle('is-hidden', delta > 0 && scrolled && !busy);
      last = y;
    };
    addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
    top.addEventListener('focusin', () => top.classList.remove('is-hidden'));
    update();
  }
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: calc(20px + env(safe-area-inset-top)) 20px;
    border-bottom: 1px solid transparent;
    transition:
      transform 200ms var(--ease),
      background-color 200ms var(--ease),
      border-color 200ms var(--ease);
  }
  .top.is-scrolled {
    padding-block: calc(12px + env(safe-area-inset-top)) 12px;
    border-bottom-color: var(--border);
  }
  .top.is-hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .top {
      transition: none;
    }
  }
  /* Get started: the one filled button, akane with white text (6.3:1), on
     every band and in the scrolled header. */
  .main-nav a.nav-btn {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    background: var(--akane);
    color: #fff;
    transition: background-color 150ms var(--ease);
  }
  .main-nav a.nav-btn:hover {
    background: #9a1f25;
    color: #fff;
  }
  .main-nav a.nav-btn:active {
    transform: scale(0.98);
  }
  .main-nav a.nav-btn[aria-current='page'] {
    text-decoration: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }
  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .brand {
    display: inline-flex;
    flex: none;
    border-radius: var(--radius);
  }
  .main-nav {
    position: relative;
  }
  ul {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a:not(.brand) {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 8px 0;
    white-space: nowrap;
    transition: color 150ms var(--ease);
  }
  a:not(.brand):hover {
    color: var(--accent);
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .menu-item,
  .more {
    display: none;
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -12px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 150ms var(--ease);
  }
  .menu-btn[hidden] {
    display: none;
  }
  .menu-btn:hover,
  .menu-btn[aria-expanded='true'] {
    background: var(--raised);
  }
  .menu-btn :global(svg) {
    display: block;
  }
  .icon-close,
  .menu-btn[aria-expanded='true'] .icon-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }
  .more .in-tiny {
    display: none;
  }
  @media (max-width: 440px) {
    .tiny {
      display: none;
    }
    .more .in-tiny {
      display: block;
    }
  }
  @media (max-width: 860px) {
    .narrow {
      display: none;
    }
    .menu-item {
      display: block;
    }
    .more:not([hidden]) {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 20;
      display: grid;
      gap: 0;
      min-width: 12rem;
      padding: 8px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-strong);
      background: var(--surface);
      box-shadow: var(--shadow);
      animation: menu-in 150ms var(--ease);
    }
    .more a {
      display: block;
      padding: 10px 12px;
      border-radius: var(--radius);
    }
    .more a:hover {
      background: var(--raised);
    }
  }
  /* Room for the logo, two links and the menu button on the narrowest phones. */
  @media (max-width: 440px) {
    .brand :global(svg) {
      height: 28px;
      width: auto;
    }
    ul {
      gap: 12px;
    }
    .menu-btn {
      margin-right: -12px;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .more:not([hidden]) {
      animation: none;
    }
  }
</style>
